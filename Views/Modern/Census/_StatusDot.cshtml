@model string
@{
  var status = Model ?? "";
  var complete = string.Equals(status, "COMPLETE", StringComparison.OrdinalIgnoreCase)
      || string.Equals(status, "Submitted", StringComparison.OrdinalIgnoreCase);
  var inProgress = string.Equals(status, "IN_PROGRESS", StringComparison.OrdinalIgnoreCase);
  var dotClass = complete
      ? "census-status-dot--complete"
      : inProgress
          ? "census-status-dot--in-progress"
          : "census-status-dot--not-started";
  var label = complete ? "Completed" : inProgress ? "In progress" : "Not started";
}
<span class="census-status-dot @dotClass" aria-hidden="true">
  @if (complete)
  {
    <svg class="census-status-dot__tick" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" focusable="false">
      <path fill="currentColor" d="M6.7 12.3 2.4 8l1.4-1.4 2.9 2.9 5.5-5.5L14 5.4z"/>
    </svg>
  }
</span>
<span class="govuk-visually-hidden">@label</span>
