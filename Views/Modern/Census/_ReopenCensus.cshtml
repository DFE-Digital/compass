@model Compass.ViewModels.Modern.ServiceCensusReopenFormModel
<form method="post" action="@Url.Action("Reopen", "ModernCensus", new { id = Model.ProductId, all = Model.ShowAll, taskKey = Model.TaskKey })">
  @Html.AntiForgeryToken()
  <p class="govuk-body">If you reopen it, you can make changes. A named contact must submit the census again before the service register is updated.</p>
  <button type="submit" class="govuk-button">Reopen the census</button>
</form>
@if (Model.CanAdminReset)
{
  <form method="post" action="@Url.Action("Reset", "ModernCensus", new { id = Model.ProductId, all = Model.ShowAll })" class="govuk-!-margin-top-4">
    @Html.AntiForgeryToken()
    <p class="govuk-body">Resetting deletes every census answer for this product. The service register is not changed until a named contact submits again.</p>
    <button type="submit" class="govuk-button govuk-button--warning">Reset census</button>
  </form>
}
