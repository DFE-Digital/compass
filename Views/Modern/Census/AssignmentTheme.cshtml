@model Compass.ViewModels.Modern.ServiceDataModels.CensusAssignmentFormViewModel
@using Compass.Helpers
@using Compass.ViewModels.Modern
@using Compass.ViewModels.Modern.ServiceDataModels
@using Microsoft.AspNetCore.Html
@{
    var group = Model.SelectedGroup;
    if (group == null)
    {
        // Defensive: controller should redirect when group is missing.
        group = new CensusFormGroupViewModel { Name = "Theme" };
    }

    ViewData["Title"] = $"{group.Name} — {Model.ModelName}";
    ViewData["CensusReadOnly"] = Model.IsReadOnly || !Model.CanEdit;
    var invalidFields = group.Fields.Where(f => !f.IsSuppressedFromForm && !f.IsValid).ToList();
    var standingHint = string.Equals(Model.ModelStableKey, "service-census", StringComparison.OrdinalIgnoreCase)
        ? "<p class=\"govuk-hint govuk-!-margin-bottom-0\">Standing service census — available any time.</p>"
        : $"<p class=\"govuk-hint govuk-!-margin-bottom-0\">Version {Model.VersionNumber}</p>";
    var progress = group.FieldCompletionPercent.HasValue
        ? $" · {group.FieldCompletionPercent:0}% complete"
        : "";
    var headerMeta = $"<p class=\"govuk-body govuk-!-margin-bottom-0\"><span class=\"dfe-f-badge dfe-f-badge--small\">{Model.Status}</span>{progress}</p>";

    var orderedGroups = Model.Groups.OrderBy(g => g.SortOrder).ToList();
    var idx = orderedGroups.FindIndex(g => g.Id == group.Id);
    Guid? nextGroupId = null;
    if (idx >= 0)
    {
        bool IsIncomplete(CensusFormGroupViewModel g) =>
            !g.IsMarkedComplete &&
            !string.Equals(g.ThemeStatusLabel, "Not applicable", StringComparison.Ordinal);

        var nextIncomplete = orderedGroups.Skip(idx + 1).FirstOrDefault(IsIncomplete);
        nextGroupId = nextIncomplete?.Id
            ?? Model.Groups.FirstOrDefault(g => g.Id != group.Id && IsIncomplete(g))?.Id;
    }

    var readOnly = Model.IsReadOnly || !Model.CanEdit;
}

@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernDashboard")">Home</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("FipsDashboard", "ModernManage")">Service register</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("WorkList", "ModernCensus")">Census</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Assignment", "ModernCensus", new { assignmentId = Model.AssignmentId })">@Model.ModelName</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">@group.Name</li>
}

@await Html.PartialAsync("_ModernPageHeader", new ModernPageHeaderViewModel {
  Caption = Model.ProductTitle,
  Title = group.Name,
  Lede = new HtmlString(headerMeta + standingHint)
})

@if (ViewBag.CensusError != null)
{
  <div class="govuk-error-summary" role="alert" data-module="govuk-error-summary">
    <h2 class="govuk-error-summary__title">There is a problem</h2>
    <div class="govuk-error-summary__body">@ViewBag.CensusError</div>
  </div>
}
@if (ViewBag.CensusMessage != null)
{
  <div class="govuk-notification-banner govuk-notification-banner--success govuk-!-margin-bottom-4" role="region" aria-labelledby="census-ok-title">
    <div class="govuk-notification-banner__header">
      <h2 class="govuk-notification-banner__title" id="census-ok-title">Success</h2>
    </div>
    <div class="govuk-notification-banner__content">
      <p class="govuk-notification-banner__heading">@ViewBag.CensusMessage</p>
    </div>
  </div>
}
@if (ViewBag.CensusWarning != null)
{
  <div class="govuk-warning-text">
    <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
    <strong class="govuk-warning-text__text">
      <span class="govuk-visually-hidden">Warning</span>
      @ViewBag.CensusWarning
    </strong>
  </div>
}

@if (invalidFields.Count > 0)
{
  <div class="govuk-error-summary" role="alert" data-module="govuk-error-summary">
    <h2 class="govuk-error-summary__title">There is a problem</h2>
    <div class="govuk-error-summary__body">
      <ul class="govuk-list govuk-error-summary__list">
        @foreach (var f in invalidFields)
        {
          <li><a href="#field-@f.Id">@(f.ValidationMessage ?? $"Check {f.Label}")</a></li>
        }
      </ul>
    </div>
  </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ChangesRequestedNote))
{
  <div class="govuk-warning-text">
    <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
    <strong class="govuk-warning-text__text">
      <span class="govuk-visually-hidden">Warning</span>
      Changes requested: @Model.ChangesRequestedNote
    </strong>
  </div>
}

<div class="govuk-grid-row notification-settings-layout">
  <div class="govuk-grid-column-one-quarter-from-desktop notification-settings-layout__nav">
    <div class="dfe-f-u-sticky govuk-!-margin-bottom-4" style="--dfe-f-sticky-top: 1rem;">
      @await Html.PartialAsync("~/Views/Modern/Census/_CensusAssignmentSideNav.cshtml", Model)
    </div>
  </div>
  <div class="govuk-grid-column-three-quarters-from-desktop">
    @if (!string.IsNullOrWhiteSpace(group.Guidance))
    {
      <div class="govuk-body compass-census-guidance">@Html.Raw(MarkdownHelper.ToSafeHtml(group.Guidance))</div>
    }

    <form method="post" id="census-assignment-form" action="@Url.Action("Save", "ModernCensus", new { assignmentId = Model.AssignmentId })" data-module="census-assignment-form">
      @Html.AntiForgeryToken()
      <input type="hidden" name="expectedUpdatedUtc" value="@Model.UpdatedUtc.ToString("o")" />
      <input type="hidden" name="groupId" value="@group.Id" />

      @await Html.PartialAsync("~/Views/Modern/Census/_CensusThemeFields.cshtml", group)

      <div class="govuk-button-group">
        @if (!readOnly)
        {
          <button type="submit" class="govuk-button" name="completeSection" value="1">Complete this section</button>
          <button type="submit" class="govuk-button">Save</button>
        }
        <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("Assignment", "ModernCensus", new { assignmentId = Model.AssignmentId })">Back to summary</a>
        @if (nextGroupId is Guid nextId)
        {
          <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("AssignmentTheme", "ModernCensus", new { assignmentId = Model.AssignmentId, groupId = nextId })">Next incomplete theme</a>
        }
      </div>
    </form>
  </div>
</div>

@section Styles {
  <style nonce="@(Context.Items["Nonce"]?.ToString() ?? "")">
    .service-line-pick { position: relative; }
    .service-line-pick__combo { position: relative; }
    .service-line-pick__results[hidden] { display: none !important; }
    .service-line-pick__results {
      position: absolute; z-index: 5; left: 0; right: 0; max-height: 16rem; overflow: auto;
      background: #fff; border: 2px solid #0b0c0c; margin-top: 2px;
    }
    .service-line-pick__results-list { margin: 0; padding: 0; list-style: none; }
    .service-line-pick__results-list li { margin: 0; border-bottom: 1px solid #b1b4b6; }
    .service-line-pick__results-list li:last-child { border-bottom: 0; }
    .service-line-pick__result-btn {
      display: block; width: 100%; text-align: left; border: 0; background: transparent;
      padding: 0.5rem 0.75rem; cursor: pointer; font: inherit; color: inherit;
    }
    .service-line-pick__result-btn:hover, .service-line-pick__result-btn:focus { background: #f3f2f1; outline: 3px solid #fd0; outline-offset: 0; }
  </style>
}

@section Scripts {
  <script src="~/modern/js/service-line-pickers.js" asp-append-version="true" nonce="@(Context.Items["Nonce"]?.ToString() ?? "")"></script>
  <script src="~/modern/js/census-assignment.js" asp-append-version="true" nonce="@(Context.Items["Nonce"]?.ToString() ?? "")"></script>
}
