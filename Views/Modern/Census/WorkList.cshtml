@model Compass.ViewModels.Modern.ServiceDataModels.CensusWorkListViewModel
@using Compass.Models
@using Compass.Services.ServiceDataModels
@using Compass.ViewModels.Modern
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Census";
    var tab = Model.Tab;
    var isYour = tab == CensusWorkListBuilder.TabYour;
    var isAll = tab == CensusWorkListBuilder.TabAll;
    var isByBa = tab == CensusWorkListBuilder.TabBusinessArea;
    var searchAndFilter = ViewBag.SearchAndFilter as SearchAndFilterViewModel;
    string TabCount(int count) => count > 0 ? $" ({count})" : "";

    object TabQuery(string tabKey) => new
    {
        tab = tabKey,
        status = Model.StatusFilter,
        search = Model.Search,
        businessAreaId = Model.BusinessAreaId,
        channelId = Model.ChannelId,
        userGroupId = Model.UserGroupId,
        phaseId = Model.PhaseId,
        typeId = Model.TypeId
    };

    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || Model.BusinessAreaId.HasValue ||
                     Model.ChannelId.HasValue || Model.UserGroupId.HasValue || Model.PhaseId.HasValue ||
                     Model.TypeId.HasValue || !string.IsNullOrWhiteSpace(Model.StatusFilter);

    string emptyMessage = isYour
        ? (hasFilters
            ? "No products you are named on match these filters."
            : "You are not a named owner or contact on any products. Products you are named on in the Service Register appear here.")
        : (hasFilters
            ? "No products match these filters."
            : "No products in this list.");
}

@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernDashboard")">Home</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("FipsDashboard", "ModernManage")">Service register</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">Census</li>
}

@await Html.PartialAsync("_ModernPageHeader", new ModernPageHeaderViewModel {
  Caption = "Service register",
  Title = "Census",
  Lede = new HtmlString("<p class=\"govuk-body govuk-!-margin-bottom-0\">Standing service data for services in the register. Keep Service Census up to date at any time.</p>")
})

<nav class="dfe-f-sub-navigation govuk-!-margin-bottom-4" aria-label="Census work scope">
  <ul class="dfe-f-sub-navigation__list">
    <li class="dfe-f-sub-navigation__item@(isYour ? " dfe-f-sub-navigation__item--active" : "")">
      <a class="dfe-f-sub-navigation__link govuk-link govuk-link--no-visited-state" href="@Url.Action("WorkList", "ModernCensus", TabQuery(CensusWorkListBuilder.TabYour))"@if (isYour) { <text> aria-current="page"</text> }>Your products<span class="dfe-c-fw-regular">@TabCount(Model.YourProductsCount)</span></a>
    </li>
    <li class="dfe-f-sub-navigation__item@(isAll ? " dfe-f-sub-navigation__item--active" : "")">
      <a class="dfe-f-sub-navigation__link govuk-link govuk-link--no-visited-state" href="@Url.Action("WorkList", "ModernCensus", TabQuery(CensusWorkListBuilder.TabAll))"@if (isAll) { <text> aria-current="page"</text> }>All products<span class="dfe-c-fw-regular">@TabCount(Model.AllProductsCount)</span></a>
    </li>
    <li class="dfe-f-sub-navigation__item@(isByBa ? " dfe-f-sub-navigation__item--active" : "")">
      <a class="dfe-f-sub-navigation__link govuk-link govuk-link--no-visited-state" href="@Url.Action("WorkList", "ModernCensus", TabQuery(CensusWorkListBuilder.TabBusinessArea))"@if (isByBa) { <text> aria-current="page"</text> }>By business area</a>
    </li>
  </ul>
</nav>

@if (!Model.CensusPublishedAvailable)
{
  <div class="govuk-inset-text">
    <p class="govuk-body govuk-!-margin-bottom-0">An administrator has not published a Service Census yet. Services will be able to complete it once it is published.</p>
  </div>
}

@if (searchAndFilter != null)
{
  <div class="govuk-!-margin-bottom-4">
    @await Html.PartialAsync("_SearchAndFilter", searchAndFilter)
  </div>
}

@if (isByBa)
{
  if (Model.BusinessAreaGroups.Count == 0)
  {
    <div class="govuk-inset-text">
      <p class="govuk-body govuk-!-margin-bottom-0">@emptyMessage</p>
    </div>
  }
  else
  {
    foreach (var group in Model.BusinessAreaGroups)
    {
      <h2 class="govuk-heading-m govuk-!-margin-top-6">@group.Name</h2>
      ViewData["CensusWorkListCaption"] = $"Census for {group.Name}";
      ViewData["CensusWorkListEmptyMessage"] = "No products in this business area.";
      @await Html.PartialAsync("~/Views/Modern/Census/_CensusWorkListTable.cshtml", group.Products)
    }
  }
}
else
{
  ViewData["CensusWorkListCaption"] = isYour ? "Your products census" : "All products census";
  ViewData["CensusWorkListEmptyMessage"] = emptyMessage;
  @await Html.PartialAsync("~/Views/Modern/Census/_CensusWorkListTable.cshtml", Model.Products.Products)
}
