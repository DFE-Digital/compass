@model string
@using Compass.Models.Modern.Work
@{
  var status = Model ?? "";
  var label = status switch
  {
    "COMPLETE" => "Completed",
    "Submitted" or "SUBMITTED" => "Submitted",
    "IN_PROGRESS" or "In progress" => "In progress",
    "Complete" or "Completed" => "Completed",
    _ => "Not started"
  };
}
<span class="@WorkBadgeCss.CensusStatusBadgeClass(status)">@label</span>
