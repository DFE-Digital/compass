@model string
@{
  var status = Model ?? "";
  var (css, label) = status switch
  {
    "COMPLETE" or "Submitted" => ("govuk-tag govuk-tag--green", status == "Submitted" ? "Submitted" : "Completed"),
    "IN_PROGRESS" => ("govuk-tag govuk-tag--blue", "In progress"),
    _ => ("govuk-tag govuk-tag--grey", "Not started")
  };
}
<strong class="@css">@label</strong>
