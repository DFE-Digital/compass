@model Compass.ViewModels.Modern.ServiceCensusTaskListViewModel
@using Microsoft.AspNetCore.Html
@{
  ViewBag.CensusProductId = Model.ProductId;
  ViewBag.CensusShowAll = Model.ShowAll;
  ViewBag.CensusCurrent = "";
  ViewBag.CensusOnTaskList = true;
}

@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernDashboard")">Home</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@(Model.ShowAll ? Url.Action("All") : Url.Action("Index"))">Service census</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">@Model.ProductTitle</li>
}

@await Html.PartialAsync("_ModernPageHeader", new Compass.ViewModels.Modern.ModernPageHeaderViewModel {
  Title = Model.ProductTitle,
  Caption = "Service census",
  Lede = new HtmlString(Model.Submitted
    ? "<p class=\"govuk-body govuk-!-margin-bottom-0\">This census has been submitted. Reopen it if you need to make changes.</p>"
    : $"<p class=\"govuk-body govuk-!-margin-bottom-0\">{Model.TasksComplete} of {Model.TaskCount} questions complete.</p>")
})

<div class="govuk-grid-row census-task-layout">
  <div class="govuk-grid-column-one-quarter-from-desktop census-task-layout__nav">
    @await Html.PartialAsync("~/Views/Modern/Census/_SideNav.cshtml", Model.Nav)
  </div>
  <div class="govuk-grid-column-three-quarters-from-desktop">
    @if (TempData["ErrorMessage"] != null)
    {
      <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert">
        <div class="govuk-error-summary__body">
          <p class="govuk-body">@TempData["ErrorMessage"]</p>
        </div>
      </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
      <div class="govuk-notification-banner govuk-notification-banner--success" role="region" aria-labelledby="census-success-title">
        <div class="govuk-notification-banner__header">
          <h2 class="govuk-notification-banner__title" id="census-success-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
          <p class="govuk-notification-banner__heading">@TempData["SuccessMessage"]</p>
        </div>
      </div>
    }
    @if (Model.Submitted)
    {
      <div class="govuk-notification-banner govuk-notification-banner--success" role="region" aria-labelledby="census-submitted-title">
        <div class="govuk-notification-banner__header">
          <h2 class="govuk-notification-banner__title" id="census-submitted-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
          <p class="govuk-notification-banner__heading">This census was submitted@(Model.SubmittedAt.HasValue ? " on " + Model.SubmittedAt.Value.ToLocalTime().ToString("d MMMM yyyy") : "").</p>
          @await Html.PartialAsync("~/Views/Modern/Census/_ReopenCensus.cshtml", new Compass.ViewModels.Modern.ServiceCensusReopenFormModel
          {
            ProductId = Model.ProductId,
            ShowAll = Model.ShowAll,
            CanAdminReset = Model.CanAdminReset
          })
        </div>
      </div>
    }

    <div class="census-task-list">
    @foreach (var group in Model.Groups)
    {
      var completeCount = group.Tasks.Count(t =>
          string.Equals(t.Status, "COMPLETE", StringComparison.OrdinalIgnoreCase)
          || string.Equals(t.Status, "Submitted", StringComparison.OrdinalIgnoreCase));
      <div class="govuk-summary-card">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title">@group.Name</h2>
          <p class="govuk-body-s govuk-!-margin-bottom-0">@completeCount of @group.Tasks.Count complete</p>
        </div>
        <div class="govuk-summary-card__content">
          <ul class="govuk-task-list">
            @foreach (var task in group.Tasks)
            {
              var statusId = "census-task-" + task.Key + "-status";
              var hintId = "census-task-" + task.Key + "-hint";
              <li class="govuk-task-list__item govuk-task-list__item--with-link">
                <div class="govuk-task-list__name-and-hint">
                  <a class="govuk-link govuk-task-list__link govuk-link--no-visited-state" href="@Url.Action("Question", "ModernCensus", new { id = Model.ProductId, taskKey = task.Key, all = Model.ShowAll })" aria-describedby="@(string.IsNullOrWhiteSpace(task.Help) ? statusId : hintId + " " + statusId)">@task.Heading</a>
                  @if (!string.IsNullOrWhiteSpace(task.Help))
                  {
                    <div id="@hintId" class="govuk-task-list__hint">@task.Help</div>
                  }
                </div>
                <div class="govuk-task-list__status" id="@statusId">
                  @await Html.PartialAsync("~/Views/Modern/Census/_StatusTag.cshtml", task.Status)
                </div>
              </li>
            }
          </ul>
        </div>
      </div>
    }

    @if (!Model.Submitted)
    {
      <div class="govuk-summary-card">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title">Submit</h2>
        </div>
        <div class="govuk-summary-card__content">
          @await Html.PartialAsync("~/Views/Modern/Census/_NamedSubmitters.cshtml", Model.NamedSubmitters)
          @if (!Model.CanSubmit)
          {
            <div class="govuk-inset-text govuk-!-margin-bottom-0">
              @if (!Model.AllComplete && !Model.UserIsOpsAdmin)
              {
                <p class="govuk-body@(Model.UserIsNamedOrAdmin ? " govuk-!-margin-bottom-0" : "")">You cannot submit until every question is marked complete.</p>
              }
              @if (!Model.UserIsNamedOrAdmin && Model.NamedSubmitters.Count == 0)
              {
                <p class="govuk-body govuk-!-margin-bottom-0">You cannot submit until people are named on the contacts page.</p>
              }
              else if (!Model.UserIsNamedOrAdmin)
              {
                <p class="govuk-body govuk-!-margin-bottom-0">You cannot submit because you are not one of the people listed.</p>
              }
            </div>
          }
          else
          {
            @if (Model.UserIsOpsAdmin && !Model.AllComplete)
            {
              <div class="govuk-inset-text">
                <p class="govuk-body govuk-!-margin-bottom-0">As an admin you can submit now. Some sections are still incomplete — only completed answers will be copied to the service register.</p>
              </div>
            }
            <a class="govuk-button govuk-!-margin-bottom-0" href="@Url.Action("Submit", "ModernCensus", new { id = Model.ProductId, all = Model.ShowAll })">Check and submit</a>
          }
        </div>
      </div>
    }
    </div>
  </div>
</div>
