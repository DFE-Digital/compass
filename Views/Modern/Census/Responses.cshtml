@model Compass.ViewModels.Modern.ServiceCensusExploreViewModel
@using Microsoft.AspNetCore.Html
@{
  var m = Model ?? new Compass.ViewModels.Modern.ServiceCensusExploreViewModel();
  var byQuestion = m.Dimension != "product";
  string AreaHref(string? area) => Url.Action("Responses", "ModernCensus", new
  {
    dim = m.Dimension,
    question = m.QuestionKey,
    product = m.ProductId,
    area,
    submittedOnly = m.SubmittedOnly
  }) ?? "#";
}

@section Styles {
  <link rel="stylesheet" href="@Url.Content("~/modern/css/service-schema-report.css")" asp-append-version="true" />
}

@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernDashboard")">Home</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernCensus")">Service census</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Report", "ModernCensus")">Report</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">Submitted data</li>
}

@await Html.PartialAsync("_ModernPageHeader", new Compass.ViewModels.Modern.ModernPageHeaderViewModel {
  Caption = "Service census",
  Title = "Submitted data",
  Lede = new HtmlString("<p class=\"govuk-body govuk-!-margin-bottom-0\">Browse census answers by question or by product. Restricted to admin and Central Operations.</p>"),
  Actions = new HtmlString("<a class=\"govuk-button govuk-button--secondary govuk-!-margin-bottom-0\" href=\"" + (Url.Action("ExportReport", "ModernCensus", new { area = m.BusinessAreaFilter }) ?? "#") + "\">Export spreadsheet</a>")
})
@if (TempData["ErrorMessage"] != null)
{
  <div class="govuk-error-summary" data-module="govuk-error-summary">
    <div class="govuk-error-summary__body">
      <p class="govuk-body">@TempData["ErrorMessage"]</p>
    </div>
  </div>
}

<form method="get" action="@Url.Action("Responses", "ModernCensus")" class="govuk-!-margin-bottom-6">
  <div class="govuk-form-group">
    <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">View by</legend>
      <div class="govuk-radios govuk-radios--inline govuk-radios--small">
        <div class="govuk-radios__item">
          <input class="govuk-radios__input" id="dim-question" name="dim" type="radio" value="question"@(byQuestion ? " checked" : "")>
          <label class="govuk-label govuk-radios__label" for="dim-question">Question</label>
        </div>
        <div class="govuk-radios__item">
          <input class="govuk-radios__input" id="dim-product" name="dim" type="radio" value="product"@(!byQuestion ? " checked" : "")>
          <label class="govuk-label govuk-radios__label" for="dim-product">Product</label>
        </div>
      </div>
    </fieldset>
  </div>

  <div class="govuk-form-group">
    <label class="govuk-label" for="census-explore-area">Business area</label>
    <select class="govuk-select" id="census-explore-area" name="area">
      <option value="">All business areas</option>
      @foreach (var option in m.BusinessAreaOptions)
      {
        if (string.Equals(m.BusinessAreaFilter, option, StringComparison.OrdinalIgnoreCase))
        {
          <option value="@option" selected>@option</option>
        }
        else
        {
          <option value="@option">@option</option>
        }
      }
    </select>
  </div>

  @if (byQuestion)
  {
    <div class="govuk-form-group">
      <label class="govuk-label" for="census-explore-question">Question</label>
      <select class="govuk-select" id="census-explore-question" name="question">
        @foreach (var question in m.Questions)
        {
          if (string.Equals(m.QuestionKey, question.Key, StringComparison.OrdinalIgnoreCase))
          {
            <option value="@question.Key" selected>@question.Section — @question.Question (@question.AveragePercent%)</option>
          }
          else
          {
            <option value="@question.Key">@question.Section — @question.Question (@question.AveragePercent%)</option>
          }
        }
      </select>
    </div>
    <input type="hidden" name="product" value="@m.ProductId" />
  }
  else
  {
    <div class="govuk-form-group">
      <label class="govuk-label" for="census-explore-product">Product</label>
      <select class="govuk-select" id="census-explore-product" name="product">
        @foreach (var product in m.Products)
        {
          if (product.Id == m.ProductId)
          {
            <option value="@product.Id" selected>@product.Title</option>
          }
          else
          {
            <option value="@product.Id">@product.Title</option>
          }
        }
      </select>
    </div>
    <input type="hidden" name="question" value="@m.QuestionKey" />
  }

  <input type="hidden" name="applied" value="1" />
  <div class="govuk-checkboxes govuk-checkboxes--small govuk-!-margin-bottom-4">
    <div class="govuk-checkboxes__item">
      <input class="govuk-checkboxes__input" id="submitted-only" name="submittedOnly" type="checkbox" value="true"@(m.SubmittedOnly ? " checked" : "")>
      <label class="govuk-label govuk-checkboxes__label" for="submitted-only">Submitted products only</label>
    </div>
  </div>
  <button type="submit" class="govuk-button">Apply</button>
  @if (!string.IsNullOrWhiteSpace(m.BusinessAreaFilter))
  {
    <p class="govuk-body govuk-!-margin-top-2"><a class="govuk-link" href="@AreaHref(null)">Clear business area</a></p>
  }
</form>

@if (byQuestion)
{
  <h2 class="govuk-heading-m">@m.SelectedQuestion</h2>
  @if (m.ValueCounts.Count > 0)
  {
    <h3 class="govuk-heading-s">Answers across products</h3>
    <div class="dfe-f-table-wrapper govuk-!-margin-bottom-6" data-module="dfe-f-table">
      <div class="govuk-visually-hidden" aria-live="polite" data-dfe-table-sort-live></div>
      <table class="govuk-table govuk-table--small-text-until-tablet dfe-f-table--condensed">
        <caption class="govuk-table__caption govuk-visually-hidden">Answer counts for @m.SelectedQuestion</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Answer</button></th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric" aria-sort="descending"><button type="button" class="dfe-f-table-sort-button">Products</button></th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          @foreach (var value in m.ValueCounts)
          {
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">@value.Value</td>
              <td class="govuk-table__cell govuk-table__cell--numeric">@value.ProductCount.ToString("N0")</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
}
else
{
  <h2 class="govuk-heading-m">@m.SelectedProduct</h2>
  @if (m.ProductId is Guid selectedId)
  {
    <p class="govuk-body"><a class="govuk-link" href="@Url.Action("TaskList", "ModernCensus", new { id = selectedId, all = true })">Open census for this product</a></p>
  }
}

@if (m.Rows.Count == 0)
{
  <p class="govuk-body">No answers in this view.</p>
}
else if (byQuestion)
{
  <div class="dfe-f-table-wrapper" data-module="dfe-f-table">
    <div class="govuk-visually-hidden" aria-live="polite" data-dfe-table-sort-live></div>
    <table class="govuk-table govuk-table--small-text-until-tablet dfe-f-table--condensed">
      <caption class="govuk-table__caption govuk-visually-hidden">Responses for @m.SelectedQuestion</caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Product</button></th>
          <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Business area</button></th>
          <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Status</button></th>
          <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Answer</button></th>
          <th scope="col" class="govuk-table__header">Details</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        @foreach (var row in m.Rows)
        {
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">
              <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("Responses", "ModernCensus", new { dim = "product", product = row.ProductId, question = m.QuestionKey, area = m.BusinessAreaFilter, submittedOnly = m.SubmittedOnly })">@row.Product</a>
            </td>
            <td class="govuk-table__cell">@row.Areas</td>
            <td class="govuk-table__cell">@row.QuestionStatus</td>
            <td class="govuk-table__cell">@(row.CannotAnswer ? "Cannot answer" : row.Item)</td>
            <td class="govuk-table__cell">@(row.CannotAnswer ? row.CannotAnswerReason : row.Details)</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}
else
{
  <div class="dfe-f-table-wrapper" data-module="dfe-f-table">
    <div class="govuk-visually-hidden" aria-live="polite" data-dfe-table-sort-live></div>
    <table class="govuk-table govuk-table--small-text-until-tablet dfe-f-table--condensed">
      <caption class="govuk-table__caption govuk-visually-hidden">Census answers for @m.SelectedProduct</caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Section</button></th>
          <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Question</button></th>
          <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Status</button></th>
          <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Answer</button></th>
          <th scope="col" class="govuk-table__header">Details</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        @foreach (var row in m.Rows)
        {
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">@row.Section</td>
            <td class="govuk-table__cell">
              <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("Responses", "ModernCensus", new { dim = "question", question = row.QuestionKey, product = m.ProductId, area = m.BusinessAreaFilter, submittedOnly = m.SubmittedOnly })">@row.Question</a>
            </td>
            <td class="govuk-table__cell">@row.QuestionStatus</td>
            <td class="govuk-table__cell">@(row.CannotAnswer ? "Cannot answer" : row.Item)</td>
            <td class="govuk-table__cell">@(row.CannotAnswer ? row.CannotAnswerReason : row.Details)</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}
