@model List<Compass.ViewModels.Modern.ServiceCensusNamedPersonViewModel>
@{
  var names = Model
    .Select(p => (p.Name ?? "").Trim())
    .Where(name => name.Length > 0)
    .Distinct(StringComparer.OrdinalIgnoreCase)
    .ToList();
}
<p class="govuk-body">One of the following people should submit this census return:</p>
@if (names.Count == 0)
{
  <p class="govuk-hint">No people have been named on the contacts page yet.</p>
}
else
{
  <ul class="govuk-list">
    @foreach (var name in names)
    {
      <li>@name</li>
    }
  </ul>
}
<p class="govuk-body">Named contacts must complete all sections before submitting. An admin can submit even if some sections are incomplete.</p>
