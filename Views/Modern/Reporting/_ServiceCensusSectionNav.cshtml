@using Compass.ViewModels.Modern
@{
    var active = (ViewBag.CensusReportActive as string) ?? "overview";
    var overviewCurrent = string.Equals(active, "overview", StringComparison.OrdinalIgnoreCase);
    var analysisCurrent = string.Equals(active, "analysis", StringComparison.OrdinalIgnoreCase);
}
<nav class="dfe-f-sub-navigation govuk-!-margin-bottom-4" aria-label="Service census reports">
  <ul class="dfe-f-sub-navigation__list">
    <li class="dfe-f-sub-navigation__item@(overviewCurrent ? " dfe-f-sub-navigation__item--active" : "")">
      <a class="dfe-f-sub-navigation__link govuk-link govuk-link--no-visited-state" href="@Url.Action("ServiceCensusOverview", "ModernReporting")"@if (overviewCurrent) { <text> aria-current="page"</text> }>Overview</a>
    </li>
    <li class="dfe-f-sub-navigation__item@(analysisCurrent ? " dfe-f-sub-navigation__item--active" : "")">
      <a class="dfe-f-sub-navigation__link govuk-link govuk-link--no-visited-state" href="@Url.Action("ServiceCensusAnalysis", "ModernReporting")"@if (analysisCurrent) { <text> aria-current="page"</text> }>Analysis</a>
    </li>
  </ul>
</nav>
