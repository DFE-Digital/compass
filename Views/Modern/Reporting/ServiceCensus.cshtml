@using Compass.ViewModels.Modern
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Service census";
    ViewBag.CensusReportActive = null;
}

@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernDashboard")">Home</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Dashboard", "ModernReporting")">Reporting</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">Service census</li>
}

<div class="reporting-dashboard">
  @await Html.PartialAsync("_ModernPageHeader", new ModernPageHeaderViewModel {
    Caption = "Reporting",
    Title = "Service census",
    Lede = new HtmlString("<p class=\"govuk-body govuk-!-margin-bottom-0\">Standing Service Census reporting — completion overview and analysis of submitted answers across shared themes.</p>")
  })

  <section class="reporting-dashboard__section" aria-labelledby="service-census-reports-heading">
    <h2 id="service-census-reports-heading" class="govuk-heading-m reporting-dashboard__section-heading">Reports</h2>
    <div class="dfe-f-card-grid reporting-dashboard__grid">
      @await Html.PartialAsync("~/Views/Modern/Reporting/_ReportingDashboardCard.cshtml", new ReportingDashboardCardViewModel {
        Title = "Overview",
        Href = Url.Action("ServiceCensusOverview", "ModernReporting") ?? "#",
        Description = "Eligible, assigned, not started, in progress, submitted and reviewed counts, with cuts by business area, directorate, product, owner, phase and type."
      })
      @await Html.PartialAsync("~/Views/Modern/Reporting/_ReportingDashboardCard.cshtml", new ReportingDashboardCardViewModel {
        Title = "Analysis",
        Href = Url.Action("ServiceCensusAnalysis", "ModernReporting") ?? "#",
        Description = "Aggregated answers across all shared census themes — drill by theme, metric, option and product."
      })
    </div>
  </section>
</div>
