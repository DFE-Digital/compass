@model IReadOnlyList<Compass.ViewModels.Modern.ExecutiveCountRow>
@{
    var rows = Model ?? Array.Empty<Compass.ViewModels.Modern.ExecutiveCountRow>();
}
@if (rows.Count == 0)
{
  <p class="govuk-body">None recorded.</p>
}
else
{
  <div class="dfe-f-table-wrapper" data-module="dfe-f-table">
    <div class="govuk-visually-hidden" aria-live="polite" data-dfe-table-sort-live></div>
    <table class="govuk-table govuk-table--small-text-until-tablet">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Name</button></th>
          @await Html.PartialAsync("_SortableThNumeric", "Work items")
          @await Html.PartialAsync("_SortableThNumeric", "Share")
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        @foreach (var row in rows)
        {
          <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">@row.Label</th>
            <td class="govuk-table__cell govuk-table__cell--numeric dfe-f-u-tabular-numbers">@row.Count</td>
            <td class="govuk-table__cell govuk-table__cell--numeric dfe-f-u-tabular-numbers">@row.Percent.ToString("0.#")%</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}
