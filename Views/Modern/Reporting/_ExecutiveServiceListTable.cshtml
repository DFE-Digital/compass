@model IReadOnlyList<Compass.ViewModels.Modern.ExecutiveServiceListRow>
@{
    var rows = Model ?? Array.Empty<Compass.ViewModels.Modern.ExecutiveServiceListRow>();
    string ProductHref(Guid id) => Url.Action("FipsProduct", "ModernManage", new { id }) ?? "#";
}
@if (rows.Count == 0)
{
  <p class="govuk-body">No services in this list.</p>
}
else
{
  <div class="dfe-f-table-wrapper" data-module="dfe-f-table">
    <div class="govuk-visually-hidden" aria-live="polite" data-dfe-table-sort-live></div>
    <table class="govuk-table govuk-table--small-text-until-tablet dfe-f-table--condensed">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Service</button></th>
          <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Phase</button></th>
          <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Business area</button></th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        @foreach (var row in rows)
        {
          <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">
              <a class="govuk-link govuk-link--no-visited-state" href="@ProductHref(row.ProductId)">@row.Title</a>
              <div class="govuk-hint govuk-!-margin-bottom-0">ID @row.UniqueId</div>
            </th>
            <td class="govuk-table__cell">@row.Phase</td>
            <td class="govuk-table__cell">@row.BusinessAreas</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}
