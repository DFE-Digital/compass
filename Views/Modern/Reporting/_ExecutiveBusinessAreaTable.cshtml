@using Compass.Models.Modern.Work
@model IReadOnlyList<Compass.ViewModels.Modern.ExecutiveBusinessAreaCompletionRow>
@{
    var rows = Model ?? Array.Empty<Compass.ViewModels.Modern.ExecutiveBusinessAreaCompletionRow>();
    string CompletionBadge(decimal percent)
    {
        var rounded = (int)Math.Round(percent, 0, MidpointRounding.AwayFromZero);
        return WorkBadgeCss.ServiceRegisterCompletionBadgeClass(rounded);
    }
    string Pct(decimal value) => value.ToString("0.#") + "%";
}
@if (rows.Count == 0)
{
  <p class="govuk-body">No business area breakdown for this return.</p>
}
else
{
  <p class="govuk-body-s govuk-hint">Lowest return rate first.</p>
  <div class="dfe-f-table-wrapper" data-module="dfe-f-table">
    <div class="govuk-visually-hidden" aria-live="polite" data-dfe-table-sort-live></div>
    <table class="govuk-table govuk-table--small-text-until-tablet" aria-label="Business area completion rates">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Business area</button></th>
          @await Html.PartialAsync("_SortableThNumeric", "Services")
          @await Html.PartialAsync("_SortableThNumeric", "Returned")
          @await Html.PartialAsync("_SortableThNumeric", "Return rate")
          @await Html.PartialAsync("_SortableThNumeric", "Metric completion")
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        @foreach (var row in rows)
        {
          <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">@row.BusinessArea</th>
            <td class="govuk-table__cell govuk-table__cell--numeric dfe-f-u-tabular-numbers">@row.Total</td>
            <td class="govuk-table__cell govuk-table__cell--numeric dfe-f-u-tabular-numbers">@row.Returned</td>
            <td class="govuk-table__cell govuk-table__cell--numeric"><span class="@CompletionBadge(row.ReturnRatePercent)">@Pct(row.ReturnRatePercent)</span></td>
            <td class="govuk-table__cell govuk-table__cell--numeric"><span class="@CompletionBadge(row.MetricCompletionPercent)">@Pct(row.MetricCompletionPercent)</span></td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}
