@{
  var navListId = "census-service-navigation";
  var sub = ViewBag.SubNavItem as string ?? "";
  bool Is(string key) => string.Equals(sub, key, StringComparison.OrdinalIgnoreCase);
}
<section aria-label="Service information" class="govuk-service-navigation" data-module="govuk-service-navigation">
  <div class="govuk-width-container">
    <div class="govuk-service-navigation__container">
      <span class="govuk-service-navigation__service-name census-service-name">
        <a class="govuk-service-navigation__link" href="@Url.Action("Index", "ModernDashboard")">COMPASS</a>
        <span class="census-service-name__sep" aria-hidden="true">|</span>
        <a class="govuk-service-navigation__link" href="@Url.Action("Index", "ModernCensus")">Service census</a>
      </span>
      <nav id="main-nav" aria-label="Menu" class="govuk-service-navigation__wrapper">
        <button type="button" class="govuk-service-navigation__toggle govuk-js-service-navigation-toggle" aria-controls="@navListId" hidden="hidden" aria-hidden="true">
          Menu
        </button>
        <ul class="govuk-service-navigation__list" id="@navListId">
          <li class="govuk-service-navigation__item@(Is("census-yours") ? " govuk-service-navigation__item--active" : "")">
            <a class="govuk-service-navigation__link" href="@Url.Action("Index", "ModernCensus")"@if (Is("census-yours")) { <text> aria-current="true"</text> }>
              @if (Is("census-yours"))
              {<strong class="govuk-service-navigation__active-fallback">Your products</strong>}
              else
              {<text>Your products</text>}
            </a>
          </li>
          <li class="govuk-service-navigation__item@(Is("census-all") ? " govuk-service-navigation__item--active" : "")">
            <a class="govuk-service-navigation__link" href="@Url.Action("All", "ModernCensus")"@if (Is("census-all")) { <text> aria-current="true"</text> }>
              @if (Is("census-all"))
              {<strong class="govuk-service-navigation__active-fallback">All products</strong>}
              else
              {<text>All products</text>}
            </a>
          </li>
          <li class="govuk-service-navigation__item@(Is("census-report") ? " govuk-service-navigation__item--active" : "")">
            <a class="govuk-service-navigation__link" href="@Url.Action("Report", "ModernCensus")"@if (Is("census-report")) { <text> aria-current="true"</text> }>
              @if (Is("census-report"))
              {<strong class="govuk-service-navigation__active-fallback">Report</strong>}
              else
              {<text>Report</text>}
            </a>
          </li>
          @if (ViewBag.CanAccessOperations == true)
          {
            <li class="govuk-service-navigation__item@(Is("census-explore") ? " govuk-service-navigation__item--active" : "")">
              <a class="govuk-service-navigation__link" href="@Url.Action("Responses", "ModernCensus")"@if (Is("census-explore")) { <text> aria-current="true"</text> }>
                @if (Is("census-explore"))
                {<strong class="govuk-service-navigation__active-fallback">Submitted data</strong>}
                else
                {<text>Submitted data</text>}
              </a>
            </li>
          }
        </ul>
      </nav>
    </div>
  </div>
</section>
