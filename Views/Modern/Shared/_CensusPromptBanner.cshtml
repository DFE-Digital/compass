@using Compass.ViewModels.Modern
@{
  var prompt = ViewBag.CensusPrompt as ServiceCensusPromptViewModel;
}
@if (prompt == null || prompt.OutstandingCount <= 0)
{
  return;
}
@{
  var href = prompt.SingleProductId is Guid id
      ? Url.Action("TaskList", "ModernCensus", new { id })
      : Url.Action("Index", "ModernCensus");
  var heading = prompt.OutstandingCount == 1
      ? "Complete the service census"
      : "Complete the service census for your products";
  var body = prompt.OutstandingCount == 1
      ? $"You are a named contact on {prompt.SingleProductTitle}. Record the remaining census information and submit it when every question is complete."
      : $"You are a named contact on {prompt.OutstandingCount} products that still need a service census. Open your products to record answers and submit when every question is complete.";
  var linkText = prompt.OutstandingCount == 1 ? "Continue census" : "Go to your products";
}
<div class="govuk-notification-banner govuk-!-margin-bottom-6" role="region" aria-labelledby="census-prompt-banner-title" data-module="govuk-notification-banner">
  <div class="govuk-notification-banner__header">
    <h2 class="govuk-notification-banner__title" id="census-prompt-banner-title">Important</h2>
  </div>
  <div class="govuk-notification-banner__content">
    <p class="govuk-notification-banner__heading">@heading</p>
    <p class="govuk-body">@body</p>
    <p class="govuk-body govuk-!-margin-bottom-0">
      <a class="govuk-notification-banner__link" href="@href">@linkText</a>
    </p>
  </div>
</div>
