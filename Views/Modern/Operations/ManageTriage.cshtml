@using System.Collections.Generic
@using Compass.Models.DemandPipeline
@using Compass.ViewModels.Modern
@{
    ViewData["Title"] = "Manage triage meetings";
    var triageTab = ViewBag.TriageTab as string ?? "upcoming";
    if (triageTab != "upcoming" && triageTab != "previous") { triageTab = "upcoming"; }
    var upcoming = ViewBag.UpcomingMeetings as List<DemandPipelineTriageMeeting> ?? new();
    var previous = ViewBag.PreviousMeetings as List<DemandPipelineTriageMeeting> ?? new();
    var demandCounts = ViewBag.TriageMeetingAssignedDemandCounts as Dictionary<Guid, int> ?? new Dictionary<Guid, int>();
    int DemandCount(Guid meetingId) => demandCounts.TryGetValue(meetingId, out var n) ? n : 0;

    string TabUrl(string t) => Url.Action("ManageTriage", "ModernOperations", new { tab = t }) ?? "#";

    string StatusBadgeClass(string? status) => status?.ToLowerInvariant() switch
    {
        "scheduled" => "dfe-f-badge dfe-f-badge--small dfe-f-badge--blue",
        "completed" => "dfe-f-badge dfe-f-badge--small dfe-f-badge--green",
        "cancelled" => "dfe-f-badge dfe-f-badge--small dfe-f-badge--red",
        _ => "dfe-f-badge dfe-f-badge--small dfe-f-badge--grey"
    };
}

@section Breadcrumbs {
 <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernDashboard")">Home</a></li>
 <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Dashboard", "ModernOperations")">Operations</a></li>
 <li class="govuk-breadcrumbs__list-item" aria-current="page">Manage triage</li>
}

@{
  var manageTriageLede = await Html.PartialAsync("_GovukBodyParagraph", "Create and schedule triage meetings. Demands can be assigned from the demand request Triage tab.");
  var manageTriageActions = await Html.PartialAsync("_ManageTriageHeaderActions");
}
@await Html.PartialAsync("_ModernPageHeader", new ModernPageHeaderViewModel {
  Caption = "Operations",
  Title = "Manage triage meetings",
  Lede = manageTriageLede,
  Actions = manageTriageActions
})

@if (TempData["Message"] != null)
{
 <div class="govuk-notification-banner govuk-notification-banner--success govuk-!-margin-bottom-3" role="region">
 <div class="govuk-notification-banner__header">
 <h2 class="govuk-notification-banner__title">Success</h2>
        </div>
 <div class="govuk-notification-banner__content">
 <p class="govuk-notification-banner__heading">@TempData["Message"]</p>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
 <div class="govuk-error-summary govuk-!-margin-bottom-3" role="alert">
 <h2 class="govuk-error-summary__title">There is a problem</h2>
 <div class="govuk-error-summary__body">@TempData["Error"]</div>
    </div>
}

<div id="sc-manage-triage" class="modern-work-page">
<nav class="dfe-f-sub-navigation govuk-!-margin-bottom-4" aria-label="Triage meetings">
 <div class="dfe-f-sub-navigation__bar">
 <ul class="dfe-f-sub-navigation__list">
 <li class="dfe-f-sub-navigation__item@(triageTab == "upcoming" ? " dfe-f-sub-navigation__item--active" : "")">
 <a class="dfe-f-sub-navigation__link govuk-link govuk-link--no-visited-state" href="@TabUrl("upcoming")" id="tab-triage-upcoming"@if (triageTab == "upcoming") { <text> aria-current="page"</text> }>Upcoming</a>
 </li>
 <li class="dfe-f-sub-navigation__item@(triageTab == "previous" ? " dfe-f-sub-navigation__item--active" : "")">
 <a class="dfe-f-sub-navigation__link govuk-link govuk-link--no-visited-state" href="@TabUrl("previous")" id="tab-triage-previous"@if (triageTab == "previous") { <text> aria-current="page"</text> }>Previous</a>
 </li>
 </ul>
 </div>
</nav>

<div id="d-triage-upcoming" class="tab-pane @(triageTab =="upcoming" ? "on" : "")" role="tabpanel" aria-labelledby="tab-triage-upcoming">
        @if (upcoming.Count == 0)
    {
 <p class="govuk-body">No upcoming meetings.</p>
    }
    else
    {
 @await Html.PartialAsync("_ManageTriageMeetingsTable", (Meetings: upcoming, ReturnTab: "upcoming", DemandCount: (Func<Guid, int>)DemandCount, StatusBadgeClass: (Func<string?, string>)StatusBadgeClass))
    }
</div>

<div id="d-triage-previous" class="tab-pane @(triageTab =="previous" ? "on" : "")" role="tabpanel" aria-labelledby="tab-triage-previous">
        @if (previous.Count == 0)
    {
 <p class="govuk-body">No previous meetings.</p>
    }
    else
    {
 @await Html.PartialAsync("_ManageTriageMeetingsTable", (Meetings: previous, ReturnTab: "previous", DemandCount: (Func<Guid, int>)DemandCount, StatusBadgeClass: (Func<string?, string>)StatusBadgeClass))
    }
</div>
</div>
