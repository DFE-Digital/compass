@using Compass.Models.DemandPipeline
@model (List<DemandPipelineTriageMeeting> Meetings, string ReturnTab, Func<Guid, int> DemandCount, Func<string?, string> StatusBadgeClass)
<div class="dfe-f-table-wrapper" data-module="dfe-f-table">
  <div class="govuk-visually-hidden" aria-live="polite" data-dfe-table-sort-live></div>
  <table class="govuk-table govuk-table--small-text-until-tablet dfe-f-table--condensed modern-work-table">
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th scope="col" class="govuk-table__header" aria-sort="none">
          <button type="button" class="dfe-f-table-sort-button">Name</button>
        </th>
        <th scope="col" class="govuk-table__header" aria-sort="none">
          <button type="button" class="dfe-f-table-sort-button">Date</button>
        </th>
        <th scope="col" class="govuk-table__header" aria-sort="none">
          <button type="button" class="dfe-f-table-sort-button">Time</button>
        </th>
        <th scope="col" class="govuk-table__header" aria-sort="none">
          <button type="button" class="dfe-f-table-sort-button">Chair</button>
        </th>
        <th scope="col" class="govuk-table__header govuk-table__header--numeric" aria-sort="none">
          <button type="button" class="dfe-f-table-sort-button">Demands</button>
        </th>
        <th scope="col" class="govuk-table__header" aria-sort="none">
          <button type="button" class="dfe-f-table-sort-button">Status</button>
        </th>
        <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody class="govuk-table__body">
      @foreach (var m in Model.Meetings)
      {
        var dc = Model.DemandCount(m.Id);
        <tr class="govuk-table__row">
          <td class="govuk-table__cell">
            <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("EditTriageMeeting", "ModernOperations", new { id = m.Id, returnTab = Model.ReturnTab })">@m.Name</a>
          </td>
          <td class="govuk-table__cell">@(m.MeetingDate?.ToString("d MMM yyyy") ?? "—")</td>
          <td class="govuk-table__cell">@FormatTimeRange(m.StartTime, m.EndTime)</td>
          <td class="govuk-table__cell">@(ExtractChairName(m.Chair) ?? "—")</td>
          <td class="govuk-table__cell govuk-table__cell--numeric">@dc</td>
          <td class="govuk-table__cell"><span class="@Model.StatusBadgeClass(m.Status)">@m.Status</span></td>
          <td class="govuk-table__cell">
            @if (dc == 0)
            {
              <form method="post" action="@Url.Action("DeleteTriageMeeting", "ModernOperations")" class="sc-manage-triage__delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@m.Id" />
                <input type="hidden" name="tab" value="@Model.ReturnTab" />
                <button type="submit" class="govuk-link govuk-link--no-visited-state" data-confirm="Are you sure you want to delete this meeting?">Delete</button>
              </form>
            }
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>

@functions {
  static string FormatTimeRange(string? start, string? end)
  {
    if (string.IsNullOrWhiteSpace(start) && string.IsNullOrWhiteSpace(end)) return "—";
    if (string.IsNullOrWhiteSpace(end)) return start ?? "—";
    if (string.IsNullOrWhiteSpace(start)) return end ?? "—";
    return $"{start} – {end}";
  }

  static string? ExtractChairName(string? chair)
  {
    if (string.IsNullOrWhiteSpace(chair)) return null;
    var idx = chair.IndexOf('(');
    return idx > 0 ? chair[..idx].Trim() : chair.Trim();
  }
}
