@model ServiceRegisterSyncRunsViewModel
@using Compass.Helpers
@using Compass.ViewModels.Modern
@{
    ViewData["Title"] = "Sync runs";
    string BadgeClass(string status) => status.Equals("Completed", StringComparison.OrdinalIgnoreCase)
        ? "dfe-f-badge dfe-f-badge--small dfe-f-badge--green"
        : status.Equals("Failed", StringComparison.OrdinalIgnoreCase)
            ? "dfe-f-badge dfe-f-badge--small dfe-f-badge--red"
            : "dfe-f-badge dfe-f-badge--small";
    string Duration(int? seconds)
    {
        if (seconds is not int value || value < 0)
            return "—";
        if (value < 60)
            return $"{value}s";
        return $"{value / 60}m {value % 60}s";
    }
    string FilterHref(string show) => Url.Action("ServiceRegisterSyncRuns", "ModernOperations", show == "all" ? null : new { show }) ?? "#";
}

@section Breadcrumbs {
    <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernDashboard")">Home</a></li>
    <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Dashboard", "ModernOperations")">Operations</a></li>
    <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("ServiceRegister", "ModernOperations")">Service register</a></li>
    <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("ServiceRegisterSyncSettings", "ModernOperations")">Sync</a></li>
    <li class="govuk-breadcrumbs__list-item" aria-current="page">Runs</li>
}

@await Html.PartialAsync("_ModernPageHeader", new ModernPageHeaderViewModel {
    Caption = "Service register",
    Title = "Sync runs",
    Lede = await Html.PartialAsync("_GovukBodyParagraph", "Each CMDB sync saves a report when it completes, fails, or hits errors. Open a run to see the products it changed.")
})

@await Html.PartialAsync("_ServiceRegisterSubNav", Model.SubNav)

<nav class="govuk-!-margin-bottom-4" aria-label="Filter sync runs">
    <ul class="govuk-list govuk-!-margin-bottom-0">
        @foreach (var item in new[] { ("all", "All"), ("completed", "Completed"), ("failed", "Failed"), ("issues", "Issues") })
        {
            var current = Model.Filter == item.Item1;
            <li style="display:inline; margin-right:1rem;">
                @if (current)
                {
                    <strong><a class="govuk-link govuk-link--no-visited-state" href="@FilterHref(item.Item1)" aria-current="page">@item.Item2</a></strong>
                }
                else
                {
                    <a class="govuk-link govuk-link--no-visited-state" href="@FilterHref(item.Item1)">@item.Item2</a>
                }
            </li>
        }
    </ul>
</nav>

@if (Model.Runs.Count == 0)
{
    <p class="govuk-body">No sync runs match this filter.</p>
}
else
{
    <p class="govuk-body">@Model.TotalCount @(Model.TotalCount == 1 ? "run" : "runs").</p>
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Started</th>
                <th scope="col" class="govuk-table__header">Result</th>
                <th scope="col" class="govuk-table__header">Run by</th>
                <th scope="col" class="govuk-table__header govuk-table__header--numeric">Created</th>
                <th scope="col" class="govuk-table__header govuk-table__header--numeric">Updated</th>
                <th scope="col" class="govuk-table__header govuk-table__header--numeric">Errors</th>
                <th scope="col" class="govuk-table__header">Duration</th>
                <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var run in Model.Runs)
            {
                var hasIssues = run.ErrorsEncountered > 0 || run.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase);
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@UkDateTime.FormatUk(run.StartedAt)</td>
                    <td class="govuk-table__cell">
                        <span class="@BadgeClass(run.Status)">@run.Status</span>
                        @if (hasIssues && run.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="dfe-f-badge dfe-f-badge--small dfe-f-badge--red govuk-!-margin-left-1">Issues</span>
                        }
                    </td>
                    <td class="govuk-table__cell">@(string.IsNullOrWhiteSpace(run.InitiatedBy) ? "—" : run.InitiatedBy)</td>
                    <td class="govuk-table__cell govuk-table__cell--numeric">@run.ProductsCreated</td>
                    <td class="govuk-table__cell govuk-table__cell--numeric">@run.ProductsUpdated</td>
                    <td class="govuk-table__cell govuk-table__cell--numeric">@run.ErrorsEncountered</td>
                    <td class="govuk-table__cell">@Duration(run.DurationSeconds)</td>
                    <td class="govuk-table__cell">
                        <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("ServiceRegisterSyncRun", "ModernOperations", new { id = run.Id })">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Pagination != null)
    {
        @await Html.PartialAsync("_GovUkPagination", Model.Pagination)
    }
}
