@model Compass.ViewModels.Modern.CapabilityListViewModel
@using Compass.ViewModels.Modern
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Capabilities";
}

@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernDashboard")">Home</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernAdmin")">Admin</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">Capabilities</li>
}

<div class="admin-hub" id="sc-admin-capabilities">
  @await Html.PartialAsync("_ModernPageHeader", new ModernPageHeaderViewModel {
    Caption = "Administration",
    Title = "Capabilities",
    Lede = new HtmlString("<p class=\"govuk-body govuk-!-margin-bottom-0\">Level 1 capabilities for census Lookup questions. Option label format: Title (Reference).</p>"),
    Actions = Model.CanManage
      ? new HtmlString($"<a class=\"govuk-button\" href=\"{Url.Action("Create", "ModernAdminCapabilities")}\">Add capability</a>")
      : null
  })

  @if (ViewBag.AdminError != null)
  {
    <div class="govuk-error-summary" role="alert" data-module="govuk-error-summary" style="margin-bottom:1rem;">
      <h2 class="govuk-error-summary__title">There is a problem</h2>
      <div class="govuk-error-summary__body">@ViewBag.AdminError</div>
    </div>
  }
  @if (ViewBag.AdminMessage != null)
  {
    <div class="govuk-notification-banner govuk-notification-banner--success govuk-!-margin-bottom-3" role="region" aria-labelledby="capabilities-ok">
      <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="capabilities-ok">Success</h2>
      </div>
      <div class="govuk-notification-banner__content">
        <p class="govuk-notification-banner__heading">@ViewBag.AdminMessage</p>
      </div>
    </div>
  }

  @if (Model.Items.Count == 0)
  {
    <p class="govuk-body">No capabilities configured yet.</p>
  }
  else
  {
    <div class="dfe-f-table-wrapper" data-module="dfe-f-table">
      <div class="govuk-visually-hidden" aria-live="polite" data-dfe-table-sort-live></div>
      <table class="govuk-table govuk-table--small-text-until-tablet dfe-f-table--condensed">
        <caption class="govuk-table__caption govuk-visually-hidden">Capabilities</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Title</button></th>
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Reference</button></th>
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Description</button></th>
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Order</button></th>
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Status</button></th>
            <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          @foreach (var row in Model.Items)
          {
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">
                <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("Edit", "ModernAdminCapabilities", new { id = row.Id })"><strong>@row.Title</strong></a>
              </td>
              <td class="govuk-table__cell"><code>@row.Reference</code></td>
              <td class="govuk-table__cell">@(string.IsNullOrEmpty(row.Description) ? "—" : row.Description)</td>
              <td class="govuk-table__cell">@row.SortOrder</td>
              <td class="govuk-table__cell">
                @if (row.IsActive)
                {
                  <span class="dfe-f-badge dfe-f-badge--small dfe-f-badge--green">Active</span>
                }
                else
                {
                  <span class="dfe-f-badge dfe-f-badge--small dfe-f-badge--grey">Disabled</span>
                }
              </td>
              <td class="govuk-table__cell">
                <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("Edit", "ModernAdminCapabilities", new { id = row.Id })">Edit</a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
