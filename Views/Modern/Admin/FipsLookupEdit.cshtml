@model Compass.ViewModels.Modern.AdminFipsLookupEditViewModel
@{
  ViewData["Title"] = Model.PageHeading;
  var listUrl = Url.Action("Index", "ModernAdmin", new { panel = Model.Panel }) ?? "#";
  bool HasError(string field) => ViewData.ModelState[field]?.Errors?.Any() == true;
  string? ErrorMsg(string field) => ViewData.ModelState[field]?.Errors?.FirstOrDefault()?.ErrorMessage;
  var nameError = HasError("name");
  var descriptionError = HasError("description");
}

@section Breadcrumbs {
 <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernDashboard")">Home</a></li>
 <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernAdmin")">Admin</a></li>
 <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@listUrl">@Model.ListLabel</a></li>
 <li class="govuk-breadcrumbs__list-item" aria-current="page">Edit</li>
}

<div class="admin-hub">
 @await Html.PartialAsync("_ModernPageHeader", new ModernPageHeaderViewModel {
   Caption = "Administration",
   Title = Model.PageHeading,
   Lede = new Microsoft.AspNetCore.Html.HtmlString($"<p class=\"govuk-body govuk-!-margin-bottom-0\"><a class=\"govuk-link\" href=\"{listUrl}\">Back to {Model.ListLabel.ToLowerInvariant()}</a></p>")
 })

  @if (TempData["AdminMessage"] != null)
  {
 <div class="govuk-notification-banner govuk-notification-banner--success govuk-!-margin-bottom-3" role="region">
 <div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">@TempData["AdminMessage"]</p></div>
    </div>
  }

  @if (!ViewData.ModelState.IsValid)
  {
    <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert">
      <h2 class="govuk-error-summary__title">There is a problem</h2>
      <div class="govuk-error-summary__body">
        <ul class="govuk-list govuk-error-summary__list">
          @foreach (var entry in ViewData.ModelState.Where(e => e.Value?.Errors.Count > 0))
          {
            <li><a href="#@entry.Key">@entry.Value!.Errors[0].ErrorMessage</a></li>
          }
        </ul>
      </div>
    </div>
  }

 <div class="dfe-c-card dfe-c-mb-4" style="border:1px solid var(--grey-2);border-left:4px solid var(--blue);padding:1.25rem 1.5rem;background:var(--white);">
    <form method="post" action="@Url.Action(Model.SaveAction, "ModernAdmin", new { id = Model.Id })" novalidate>
      @Html.AntiForgeryToken()
 <div class="govuk-form-group@(nameError ? " govuk-form-group--error" : "")">
 <label class="govuk-label" for="name">Name</label>
        @if (nameError)
        {
 <p id="name-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @ErrorMsg("name")</p>
        }
 <input class="govuk-input govuk-!-width-two-thirds@(nameError ? " govuk-input--error" : "")" id="name" name="name" value="@Model.Name" required maxlength="450" aria-describedby="@(nameError ? "name-error" : null)" />
      </div>
 <div class="govuk-form-group@(descriptionError ? " govuk-form-group--error" : "")">
 <label class="govuk-label" for="description">Description</label>
        @if (descriptionError)
        {
 <p id="description-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @ErrorMsg("description")</p>
        }
 <textarea class="govuk-textarea@(descriptionError ? " govuk-textarea--error" : "")" id="description" name="description" rows="3" maxlength="450" aria-describedby="@(descriptionError ? "description-error" : null)">@Model.Description</textarea>
      </div>
 <div class="govuk-form-group">
 <label class="govuk-label" for="displayOrder">Display order</label>
 <input class="govuk-input govuk-input--width-5" id="displayOrder" name="displayOrder" type="number" value="@Model.DisplayOrder" />
      </div>
 <button type="submit" class="govuk-button">Save</button>
    </form>
  </div>

  <div class="dfe-c-card dfe-c-mb-4" style="border:1px solid var(--grey-2);padding:1.25rem 1.5rem;background:var(--white);">
 <h2 class="govuk-heading-s">Status</h2>
 <p class="govuk-body govuk-!-margin-bottom-2">
      @if (Model.IsActive)
      {
        <span class="dfe-f-badge dfe-f-badge--small dfe-f-badge--green">Active</span>
      }
      else
      {
        <span class="dfe-f-badge dfe-f-badge--small dfe-f-badge--grey">Inactive</span>
      }
    </p>
    <form method="post" action="@Url.Action(Model.ToggleAction, "ModernAdmin", new { id = Model.Id })">
      @Html.AntiForgeryToken()
 <button type="submit" class="govuk-button govuk-button--secondary">@(Model.IsActive ? "Deactivate" : "Activate")</button>
    </form>
  </div>
</div>
