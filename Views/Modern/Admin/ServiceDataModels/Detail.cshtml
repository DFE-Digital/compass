@model Compass.ViewModels.Modern.ServiceDataModels.ServiceDataModelDetailViewModel
@using Compass.Models.ServiceDataModels
@using Compass.ViewModels.Modern
@using Compass.ViewModels.Modern.ServiceDataModels
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.Name;
    string LifecycleBadge(ServiceDataModelLifecycleStatus s) => s switch
    {
        ServiceDataModelLifecycleStatus.Published => "dfe-f-badge dfe-f-badge--small dfe-f-badge--green",
        ServiceDataModelLifecycleStatus.Retired => "dfe-f-badge dfe-f-badge--small dfe-f-badge--grey",
        _ => "dfe-f-badge dfe-f-badge--small dfe-f-badge--blue"
    };
    var publishActions = "";
    if (Model.CanManage && Model.DraftVersionId.HasValue)
    {
        publishActions = $"<a class=\"govuk-button\" href=\"{Url.Action("Publish", "ModernAdminServiceDataModels", new { id = Model.Id }) ?? "#"}\">Publish draft</a>";
    }
}

@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernDashboard")">Home</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernAdmin")">Admin</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernAdminServiceDataModels")">Service data models</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">@Model.Name</li>
}

<div class="admin-hub" id="sc-admin-sdm-detail">
  @await Html.PartialAsync("_ModernPageHeader", new ModernPageHeaderViewModel {
    Caption = "Administration",
    Title = Model.Name,
    Lede = new HtmlString($"<p class=\"govuk-body govuk-!-margin-bottom-0\"><code>{Model.StableKey}</code> · <span class=\"{LifecycleBadge(Model.LifecycleStatus)}\">{Model.LifecycleStatus}</span></p>"),
    Actions = string.IsNullOrEmpty(publishActions) ? null : new HtmlString($"<div class=\"dfe-c-flex\" style=\"gap:0.5rem;flex-wrap:wrap;\">{publishActions}</div>")
  })

  @if (ViewBag.AdminError != null)
  {
    <div class="govuk-error-summary" role="alert" data-module="govuk-error-summary" style="margin-bottom:1rem;">
      <h2 class="govuk-error-summary__title">There is a problem</h2>
      <div class="govuk-error-summary__body">@ViewBag.AdminError</div>
    </div>
  }
  @if (ViewBag.AdminMessage != null)
  {
    <div class="govuk-notification-banner govuk-notification-banner--success govuk-!-margin-bottom-3" role="region" aria-labelledby="sdm-detail-ok">
      <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="sdm-detail-ok">Success</h2>
      </div>
      <div class="govuk-notification-banner__content">
        <p class="govuk-notification-banner__heading">@ViewBag.AdminMessage</p>
      </div>
    </div>
  }

  @if (Model.SharedCensusThemes.Count == 0 && Model.CanManage)
  {
    <div class="govuk-inset-text">
      <p class="govuk-body">This model has no shared themes yet. Manage the default catalogue, or seed the Service Census draft if this is a new environment.</p>
      <p class="govuk-body">
        <a class="govuk-link" href="@Url.Action("Index", "ModernAdminDefaultCensusThemes")">Open default census themes</a>
      </p>
      <form method="post" action="@Url.Action("SeedServiceCensus", "ModernAdminServiceDataModels")" class="govuk-!-margin-top-2">
        @Html.AntiForgeryToken()
        <button type="submit" class="govuk-button">Seed Service Census draft</button>
      </form>
    </div>
  }

  <h2 class="govuk-heading-m">Settings</h2>
  @if (Model.CanManage)
  {
    <form method="post" action="@Url.Action("UpdateSettings", "ModernAdminServiceDataModels", new { id = Model.Id })" class="govuk-!-margin-bottom-6">
      @Html.AntiForgeryToken()
      <div class="govuk-form-group">
        <label class="govuk-label" for="Name">Name</label>
        <input class="govuk-input govuk-!-width-two-thirds" id="Name" name="Name" type="text" maxlength="200" value="@Model.Name" required />
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="Description">Description</label>
        <textarea class="govuk-textarea govuk-!-width-two-thirds" id="Description" name="Description" rows="3" maxlength="2000">@Model.Description</textarea>
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="OwnerDisplayName">Owner display name</label>
        <input class="govuk-input govuk-!-width-two-thirds" id="OwnerDisplayName" name="OwnerDisplayName" type="text" maxlength="200" value="@Model.OwnerDisplayName" />
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="OwnerEmail">Owner email</label>
        <input class="govuk-input govuk-!-width-two-thirds" id="OwnerEmail" name="OwnerEmail" type="email" maxlength="320" value="@Model.OwnerEmail" />
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="Classification">Classification</label>
        <input class="govuk-input govuk-!-width-two-thirds" id="Classification" name="Classification" type="text" maxlength="100" value="@Model.Classification" />
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="ReviewCadenceLabel">Review cadence label (optional)</label>
        <div class="govuk-hint">For period-based models only. Leave blank for standing models such as Service Census.</div>
        <input class="govuk-input govuk-!-width-one-third" id="ReviewCadenceLabel" name="ReviewCadenceLabel" type="text" maxlength="100" value="@Model.ReviewCadenceLabel" />
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="DefaultDueDaysAfterPublish">Default due days after publish (optional)</label>
        <div class="govuk-hint">Leave blank for no deadline. Missing due dates are not treated as overdue.</div>
        <input class="govuk-input govuk-input--width-5" id="DefaultDueDaysAfterPublish" name="DefaultDueDaysAfterPublish" type="number" value="@Model.DefaultDueDaysAfterPublish" />
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="ProgressLabelThresholdPercent">Progress label threshold %</label>
        <input class="govuk-input govuk-input--width-5" id="ProgressLabelThresholdPercent" name="ProgressLabelThresholdPercent" type="number" min="0" max="100" value="@Model.ProgressLabelThresholdPercent" />
      </div>
      <div class="govuk-form-group">
        <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
          <div class="govuk-checkboxes__item">
            <input class="govuk-checkboxes__input" id="IsRepeatable" name="IsRepeatable" type="checkbox" value="true" @(Model.IsRepeatable ? "checked" : null) />
            <label class="govuk-label govuk-checkboxes__label" for="IsRepeatable">Repeatable (new assignment each period)</label>
          </div>
          <div class="govuk-checkboxes__item">
            <input class="govuk-checkboxes__input" id="IsReportable" name="IsReportable" type="checkbox" value="true" @(Model.IsReportable ? "checked" : null) />
            <label class="govuk-label govuk-checkboxes__label" for="IsReportable">Reportable</label>
          </div>
          <div class="govuk-checkboxes__item">
            <input class="govuk-checkboxes__input" id="RequiresReviewerAttestation" name="RequiresReviewerAttestation" type="checkbox" value="true" @(Model.RequiresReviewerAttestation ? "checked" : null) />
            <label class="govuk-label govuk-checkboxes__label" for="RequiresReviewerAttestation">Requires reviewer attestation</label>
          </div>
        </div>
        <input type="hidden" name="IsRepeatable" value="false" />
        <input type="hidden" name="IsReportable" value="false" />
        <input type="hidden" name="RequiresReviewerAttestation" value="false" />
      </div>
      <button type="submit" class="govuk-button">Save settings</button>
    </form>
  }
  else
  {
    <p class="govuk-body">@(Model.Description ?? "No description.")</p>
  }

  <h2 class="govuk-heading-m">Applicability</h2>
  <p class="govuk-body">Mode: <strong>@Model.ApplicabilityMode</strong> · Assigned services: <strong>@Model.AssignedCount</strong></p>
  @if (Model.ApplicabilityRules.Count > 0)
  {
    <ul class="govuk-list govuk-list--bullet">
      @foreach (var rule in Model.ApplicabilityRules)
      {
        <li>
          Status @(rule.ProductStatus?.ToString() ?? "any"),
          phase @(rule.PhaseId?.ToString() ?? "any"),
          type @(rule.FipsTypeId?.ToString() ?? "any"),
          business area @(rule.FipsBusinessAreaId?.ToString() ?? "any"),
          directorate @(rule.FipsDirectorateId?.ToString() ?? "any")
        </li>
      }
    </ul>
  }
  @if (Model.CanManage)
  {
    <p class="govuk-body">
      <a class="govuk-link" href="@Url.Action("SetApplicability", "ModernAdminServiceDataModels", new { id = Model.Id })">Set applicability</a>
      ·
      <a class="govuk-link" href="@Url.Action("PreviewApplicability", "ModernAdminServiceDataModels", new { id = Model.Id })">Preview affected services</a>
    </p>
  }

  <h2 class="govuk-heading-m">Themes</h2>
  <p class="govuk-hint">Every census inherits the shared default theme catalogue. Theme and question definitions are not owned by this model — edit them once under Default census themes.</p>

  @if (Model.CanManage)
  {
    <p class="govuk-body">
      <a class="govuk-button" href="@Url.Action("Index", "ModernAdminDefaultCensusThemes")">Manage default census themes</a>
    </p>
  }

  @{
    var sharedThemes = Model.SharedCensusThemes.OrderBy(t => t.Name).ToList();
  }
  @if (sharedThemes.Count == 0)
  {
    <p class="govuk-body">No shared themes yet. Open Default census themes to seed or create the base set.</p>
  }
  else
  {
    <div class="dfe-f-table-wrapper" data-module="dfe-f-table">
      <table class="govuk-table govuk-table--small-text-until-tablet dfe-f-table--condensed">
        <caption class="govuk-table__caption govuk-visually-hidden">Shared census themes</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Theme</th>
            <th scope="col" class="govuk-table__header">Questions</th>
            <th scope="col" class="govuk-table__header">Status</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          @foreach (var theme in sharedThemes)
          {
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">
                @if (Model.CanManage)
                {
                  <a class="govuk-link" href="@Url.Action("EditTheme", "ModernAdminDefaultCensusThemes", new { themeId = theme.Id })">@theme.Name</a>
                }
                else
                {
                  @theme.Name
                }
                <span class="govuk-!-font-size-16 dfe-c-text-muted"> (<code>@theme.StableKey</code>)</span>
                @if (!string.IsNullOrWhiteSpace(theme.Guidance))
                {
                  <div class="govuk-hint govuk-!-margin-bottom-0">@theme.Guidance</div>
                }
              </td>
              <td class="govuk-table__cell">@theme.FieldCount</td>
              <td class="govuk-table__cell">
                @if (theme.IsActive)
                {
                  <span class="dfe-f-badge dfe-f-badge--small dfe-f-badge--green">Shared</span>
                }
                else
                {
                  <span class="dfe-f-badge dfe-f-badge--small dfe-f-badge--grey">Disabled</span>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }

  <h2 class="govuk-heading-m govuk-!-margin-top-6">Versions</h2>
  @if (Model.Versions.Count == 0)
  {
    <p class="govuk-body">No versions yet.</p>
  }
  else
  {
    <div class="dfe-f-table-wrapper" data-module="dfe-f-table">
      <table class="govuk-table govuk-table--small-text-until-tablet dfe-f-table--condensed">
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Version</th>
            <th scope="col" class="govuk-table__header">Status</th>
            <th scope="col" class="govuk-table__header">Period</th>
            <th scope="col" class="govuk-table__header">Published</th>
            <th scope="col" class="govuk-table__header">Change summary</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          @foreach (var v in Model.Versions.OrderByDescending(x => x.VersionNumber))
          {
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">v@v.VersionNumber</td>
              <td class="govuk-table__cell"><span class="@LifecycleBadge(v.Status)">@v.Status</span></td>
              <td class="govuk-table__cell">@(v.PeriodLabel ?? "—")</td>
              <td class="govuk-table__cell">@(v.PublishedUtc?.ToString("d MMM yyyy HH:mm") ?? "—")</td>
              <td class="govuk-table__cell">@(v.ChangeSummary ?? "—")</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }

  @if (Model.CanManage && Model.LifecycleStatus != ServiceDataModelLifecycleStatus.Retired)
  {
    <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible" />
    <h2 class="govuk-heading-m">Retire model</h2>
    <p class="govuk-body">Retiring keeps historical submissions but stops new assignments.</p>
    <form method="post" action="@Url.Action("Retire", "ModernAdminServiceDataModels", new { id = Model.Id })"
          data-confirm-title="Retire this model?"
          data-confirm-message="Historical submissions are kept. New assignments will stop.">
      @Html.AntiForgeryToken()
      <button type="submit" class="govuk-button govuk-button--warning">Retire model</button>
    </form>
  }
</div>
