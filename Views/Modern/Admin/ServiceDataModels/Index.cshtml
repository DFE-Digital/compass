@model Compass.ViewModels.Modern.ServiceDataModels.ServiceDataModelListViewModel
@using Compass.Models.ServiceDataModels
@using Compass.ViewModels.Modern
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Service data models";
    string LifecycleBadge(ServiceDataModelLifecycleStatus s) => s switch
    {
        ServiceDataModelLifecycleStatus.Published => "dfe-f-badge dfe-f-badge--small dfe-f-badge--green",
        ServiceDataModelLifecycleStatus.Retired => "dfe-f-badge dfe-f-badge--small dfe-f-badge--grey",
        _ => "dfe-f-badge dfe-f-badge--small dfe-f-badge--blue"
    };
}

@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernDashboard")">Home</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernAdmin")">Admin</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">Service data models</li>
}

<div class="admin-hub" id="sc-admin-service-data-models">
  @{
    var actions = new HtmlString($"<div class=\"dfe-c-flex\" style=\"gap:0.5rem;flex-wrap:wrap;align-items:center;\"><a class=\"govuk-button\" href=\"{Url.Action("Create", "ModernAdminServiceDataModels") ?? "#"}\">Create model</a></div>");
    var lede = new HtmlString("<p class=\"govuk-body govuk-!-margin-bottom-0\">Define reusable models such as Service Census, publish versions, and assign them to Service Register products.</p>");
  }
  @await Html.PartialAsync("_ModernPageHeader", new ModernPageHeaderViewModel {
    Caption = "Administration",
    Title = "Service data models",
    Lede = lede,
    Actions = actions
  })

  @if (ViewBag.AdminError != null)
  {
    <div class="govuk-error-summary" role="alert" data-module="govuk-error-summary" style="margin-bottom:1rem;">
      <h2 class="govuk-error-summary__title">There is a problem</h2>
      <div class="govuk-error-summary__body">@ViewBag.AdminError</div>
    </div>
  }
  @if (ViewBag.AdminMessage != null)
  {
    <div class="govuk-notification-banner govuk-notification-banner--success govuk-!-margin-bottom-3" role="region" aria-labelledby="sdm-notif-title">
      <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="sdm-notif-title">Success</h2>
      </div>
      <div class="govuk-notification-banner__content">
        <p class="govuk-notification-banner__heading">@ViewBag.AdminMessage</p>
      </div>
    </div>
  }

  @if (Model.Rows.Count == 0)
  {
    <div class="govuk-inset-text">
      <p class="govuk-body">No service data models yet. Create one, or seed the default Service Census draft.</p>
      <form method="post" action="@Url.Action("SeedServiceCensus", "ModernAdminServiceDataModels")" class="govuk-!-margin-top-2">
        @Html.AntiForgeryToken()
        <button type="submit" class="govuk-button">Seed Service Census draft</button>
      </form>
    </div>
  }
  else
  {
    <div class="dfe-f-table-wrapper" data-module="dfe-f-table">
      <div class="govuk-visually-hidden" aria-live="polite" data-dfe-table-sort-live></div>
      <table class="govuk-table govuk-table--small-text-until-tablet dfe-f-table--condensed">
        <caption class="govuk-table__caption govuk-table__caption--m">Models</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Name</button></th>
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Key</button></th>
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Owner</button></th>
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Status</button></th>
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Version</button></th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Assigned</button></th>
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Updated</button></th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          @foreach (var row in Model.Rows)
          {
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">
                <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("Detail", "ModernAdminServiceDataModels", new { id = row.Id })"><strong>@row.Name</strong></a>
              </td>
              <td class="govuk-table__cell"><code>@row.StableKey</code></td>
              <td class="govuk-table__cell">@(row.OwnerDisplayName ?? row.OwnerEmail ?? "—")</td>
              <td class="govuk-table__cell"><span class="@LifecycleBadge(row.LifecycleStatus)">@row.LifecycleStatus</span></td>
              <td class="govuk-table__cell">
                @if (row.CurrentVersionNumber.HasValue)
                {
                  <text>v@(row.CurrentVersionNumber)</text>
                  if (row.CurrentVersionStatus.HasValue)
                  {
                    <span class="@LifecycleBadge(row.CurrentVersionStatus.Value)">@row.CurrentVersionStatus</span>
                  }
                }
                else
                {
                  <text>—</text>
                }
              </td>
              <td class="govuk-table__cell govuk-table__cell--numeric">@row.AssignedCount</td>
              <td class="govuk-table__cell">@row.UpdatedUtc.ToString("d MMM yyyy HH:mm")</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
