@model Compass.ViewModels.Modern.ServiceSchemaLookupAdminPage
@using Compass.ViewModels.Modern
@using Microsoft.AspNetCore.Html
@{
  ViewData["Title"] = "Service schema lookups";
  ViewBag.SchemaNav = "lookups";
}
@section Breadcrumbs {
 <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernDashboard")">Home</a></li>
 <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernAdmin")">Admin</a></li>
 <li class="govuk-breadcrumbs__list-item" aria-current="page">Service schema</li>
}
<div class="admin-hub">
 @await Html.PartialAsync("_ModernPageHeader", new ModernPageHeaderViewModel {
   Caption = "Administration",
   Title = "Service schema",
   Lede = new HtmlString("<p class=\"govuk-body govuk-!-margin-bottom-0\">Schema forms use the lookups already managed in Admin. RAID lists are not used. Open a lookup to add or retire values.</p>")
 })
 @await Html.PartialAsync("~/Views/Modern/Admin/ServiceSchema/_Messages.cshtml")
 <div class="govuk-grid-row">
  <div class="govuk-grid-column-one-quarter">
   @await Html.PartialAsync("~/Views/Modern/Admin/ServiceSchema/_Nav.cshtml")
  </div>
  <div class="govuk-grid-column-three-quarters">
   <table class="govuk-table">
    <thead class="govuk-table__head">
     <tr class="govuk-table__row">
      <th scope="col" class="govuk-table__header">Lookup</th>
      <th scope="col" class="govuk-table__header">Where it is managed</th>
     </tr>
    </thead>
    <tbody class="govuk-table__body">
     @foreach (var source in Compass.Services.ServiceSchema.ServiceSchemaAdminLookups.Sources)
     {
      <tr class="govuk-table__row">
       <td class="govuk-table__cell">@source.Label</td>
       <td class="govuk-table__cell"><a class="govuk-link" href="@Url.Action("Index", "ModernAdmin", new { panel = source.AdminPanel })">Admin</a></td>
      </tr>
     }
    </tbody>
   </table>
  </div>
 </div>
</div>
