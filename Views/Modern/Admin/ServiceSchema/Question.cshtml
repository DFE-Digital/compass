@model Compass.ViewModels.Modern.ServiceSchemaQuestionEditPage
@using Compass.ViewModels.Modern
@using Microsoft.AspNetCore.Html
@{
  var creating = Model.Id == 0;
  ViewData["Title"] = creating ? "Add a service schema question" : "Change a service schema question";
  ViewBag.SchemaNav = "questions";
  var action = creating
    ? Url.Action("CreateQuestion", "ModernAdminServiceSchema")
    : Url.Action("UpdateQuestion", "ModernAdminServiceSchema", new { id = Model.Id });
}
@section Breadcrumbs {
 <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernDashboard")">Home</a></li>
 <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernAdmin")">Admin</a></li>
 <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Questions", "ModernAdminServiceSchema")">Service schema</a></li>
 <li class="govuk-breadcrumbs__list-item" aria-current="page">@(creating ? "Add question" : Model.Heading)</li>
}
<div class="admin-hub">
 @await Html.PartialAsync("_ModernPageHeader", new ModernPageHeaderViewModel {
   Caption = "Service schema",
   Title = creating ? "Add a question" : Model.Heading,
   Lede = new HtmlString("<p class=\"govuk-body govuk-!-margin-bottom-0\">Choose how people answer. The question key stays the same, so responses already saved keep their place.</p>")
 })
 @await Html.PartialAsync("~/Views/Modern/Admin/ServiceSchema/_Messages.cshtml")
 <div class="govuk-grid-row">
  <div class="govuk-grid-column-one-quarter">
   @await Html.PartialAsync("~/Views/Modern/Admin/ServiceSchema/_Nav.cshtml")
  </div>
  <div class="govuk-grid-column-three-quarters">
   <form method="post" action="@action">
    @Html.AntiForgeryToken()
    <div class="govuk-form-group">
     <label class="govuk-label" for="section">Area</label>
     <select class="govuk-select" id="section" name="section">
      @foreach (var area in Model.Areas)
      {
       if (string.Equals(area.Value, Model.AreaKey, StringComparison.OrdinalIgnoreCase))
       {
        <option value="@area.Value" selected>@area.Label</option>
       }
       else
       {
        <option value="@area.Value">@area.Label</option>
       }
      }
     </select>
    </div>
    <div class="govuk-form-group">
     <label class="govuk-label" for="heading">Question</label>
     <input class="govuk-input" id="heading" name="heading" type="text" value="@Model.Heading" />
    </div>
    <div class="govuk-form-group">
     <label class="govuk-label" for="help">Short help</label>
     <div class="govuk-hint">Optional one or two sentences under the question. Prefer the help panel for longer guidance.</div>
     <textarea class="govuk-textarea" id="help" name="help" rows="3">@Model.Help</textarea>
    </div>
    <div class="govuk-form-group">
     <label class="govuk-label" for="helpPanel">Help panel</label>
     <div class="govuk-hint">Shown in the help blade when someone clicks Help on this question. Markdown is supported.</div>
     <textarea class="govuk-textarea" id="helpPanel" name="helpPanel" rows="8">@Model.HelpPanel</textarea>
    </div>
    <div class="govuk-form-group">
     <label class="govuk-label" for="titleLabel">Title label</label>
     <div class="govuk-hint">The label on the name field when someone adds a response.</div>
     <input class="govuk-input" id="titleLabel" name="titleLabel" type="text" value="@Model.TitleLabel" />
    </div>
    <div class="govuk-form-group">
     <label class="govuk-label" for="narrativeLabel">Description label</label>
     <input class="govuk-input" id="narrativeLabel" name="narrativeLabel" type="text" value="@Model.NarrativeLabel" />
    </div>
    @if (!creating)
    {
     <div class="govuk-form-group">
      <label class="govuk-label" for="sortOrder">Order</label>
      <input class="govuk-input govuk-input--width-5" id="sortOrder" name="sortOrder" type="number" value="@Model.SortOrder" />
     </div>
    }
    <fieldset class="govuk-fieldset govuk-!-margin-bottom-6">
     <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">How people answer</legend>
     <div class="govuk-radios" data-module="govuk-radios" id="response-mode">
      @foreach (var mode in new (string Value, string Label, string Hint)[]
      {
        ("text", "Text", "A title and a description, typed on the product."),
        ("lookup", "Select from a list", "A dropdown. Choose which list it uses."),
        ("catalogue", "Autocomplete", "A shared list. People can search it and add a new name."),
        ("choice", "Choice", "One option from a short list you write here."),
        ("yes-choice", "Yes or no, then a choice", "Yes or no. A yes answer then chooses from the list and can include a description."),
        ("products", "Service register products", "Other products already on the service register.")
      })
      {
       var modeId = "response-mode-" + mode.Value;
       var selected = string.Equals(Model.ResponseMode, mode.Value, StringComparison.OrdinalIgnoreCase);
       <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="@modeId" name="responseMode" type="radio" value="@mode.Value" @(selected ? "checked" : null) />
        <label class="govuk-label govuk-radios__label" for="@modeId">@mode.Label</label>
        <div class="govuk-hint govuk-radios__hint">@mode.Hint</div>
       </div>
      }
     </div>
     <div class="govuk-form-group govuk-!-margin-top-4" id="response-panel-lookup" hidden>
      <label class="govuk-label" for="lookupSource">List</label>
      <select class="govuk-select" id="lookupSource" name="lookupSource">
       <option value="">Select a list</option>
       @foreach (var lookup in Model.Lookups)
       {
        if (string.Equals(lookup.Value, Model.LookupSource, StringComparison.OrdinalIgnoreCase))
        {
         <option value="@lookup.Value" selected>@lookup.Label</option>
        }
        else
        {
         <option value="@lookup.Value">@lookup.Label</option>
        }
       }
      </select>
     </div>
     <div class="govuk-form-group govuk-!-margin-top-4" id="response-panel-catalogue" hidden>
      <label class="govuk-label" for="catalogueKind">Autocomplete list</label>
      <select class="govuk-select" id="catalogueKind" name="catalogueKind">
       @{
        var ownList = string.Equals(Model.CatalogueKind, "question", StringComparison.OrdinalIgnoreCase);
       }
       @if (ownList)
       {
        <option value="question" selected>A list for this question</option>
       }
       else
       {
        <option value="question">A list for this question</option>
       }
       @foreach (var kind in Model.CatalogueKinds)
       {
        if (!ownList && string.Equals(kind.Value, Model.CatalogueKind, StringComparison.OrdinalIgnoreCase))
        {
         <option value="@kind.Value" selected>@kind.Label</option>
        }
        else
        {
         <option value="@kind.Value">@kind.Label</option>
        }
       }
      </select>
     </div>
     <div class="govuk-form-group govuk-!-margin-top-4" id="response-panel-choice" hidden>
      <label class="govuk-label" for="choiceOptions">Choices</label>
      <div class="govuk-hint">One choice on each line. At least two.</div>
      <textarea class="govuk-textarea" id="choiceOptions" name="choiceOptions" rows="5">@Model.ChoiceOptions</textarea>
     </div>
    </fieldset>
    <div class="govuk-form-group">
     <div class="govuk-checkboxes" data-module="govuk-checkboxes">
      <div class="govuk-checkboxes__item">
       <input class="govuk-checkboxes__input" id="isActive" name="isActive" type="checkbox" value="true" @(Model.IsActive ? "checked" : null) />
       <label class="govuk-label govuk-checkboxes__label" for="isActive">Show this question on service schema records</label>
      </div>
     </div>
    </div>
    <button class="govuk-button" type="submit">@(creating ? "Add question" : "Save question")</button>
   </form>
   @if (!creating && !Model.IsBuiltIn)
   {
    <form method="post" action="@Url.Action("RemoveQuestion", "ModernAdminServiceSchema", new { id = Model.Id })" data-confirm-title="Remove @Model.Heading?" data-confirm-message="@(Model.HasResponses ? "This question has responses, so it will be hidden. Those responses stay stored." : "This removes the question from the service schema.")">
     @Html.AntiForgeryToken()
     <button class="govuk-button govuk-button--warning" type="submit">Remove question</button>
    </form>
   }
   <script nonce="@(Context.Items["Nonce"]?.ToString() ?? "")">
   (function () {
     var extras = ["lookup", "catalogue", "choice"];
     function show() {
       var selected = document.querySelector("#response-mode input:checked");
       var value = selected ? selected.value : "text";
       extras.forEach(function (mode) {
         var panel = document.getElementById("response-panel-" + mode);
         if (!panel) return;
         panel.hidden = mode !== value && !(mode === "choice" && value === "yes-choice");
       });
     }
     document.querySelectorAll("#response-mode input").forEach(function (input) {
       input.addEventListener("change", show);
     });
     show();
   })();
   </script>
  </div>
 </div>
</div>
