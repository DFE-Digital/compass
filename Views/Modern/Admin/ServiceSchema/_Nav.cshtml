@{
  var current = ViewBag.SchemaNav as string ?? "questions";
  string Item(string key, string label, string href)
  {
    var cls = string.Equals(current, key, StringComparison.OrdinalIgnoreCase) ? " dfe-f-side-navigation__item--current" : "";
    var aria = string.Equals(current, key, StringComparison.OrdinalIgnoreCase) ? " aria-current=\"page\"" : "";
    return $"<li class=\"dfe-f-side-navigation__item{cls}\"><a class=\"dfe-f-side-navigation__link govuk-link govuk-link--no-visited-state\" href=\"{href}\"{aria}>{label}</a></li>";
  }
}
<nav class="dfe-f-side-navigation" aria-label="Service schema" data-module="dfe-f-side-navigation">
  <ul class="dfe-f-side-navigation__list">
    @Html.Raw(Item("questions", "Questions", Url.Action("Questions", "ModernAdminServiceSchema") ?? "#"))
    @Html.Raw(Item("lookups", "Lookups", Url.Action("Lookups", "ModernAdminServiceSchema") ?? "#"))
    @Html.Raw(Item("pattern", "Patterns and components", Url.Action("Catalogue", "ModernAdminServiceSchema", new { kind = "pattern" }) ?? "#"))
    @Html.Raw(Item("api", "APIs", Url.Action("Catalogue", "ModernAdminServiceSchema", new { kind = "api" }) ?? "#"))
    @Html.Raw(Item("technology", "Technologies and components", Url.Action("Catalogue", "ModernAdminServiceSchema", new { kind = "technology" }) ?? "#"))
    @Html.Raw(Item("stack", "Stacks and platforms", Url.Action("Catalogue", "ModernAdminServiceSchema", new { kind = "stack" }) ?? "#"))
    @Html.Raw(Item("integration", "Integrations", Url.Action("Catalogue", "ModernAdminServiceSchema", new { kind = "integration" }) ?? "#"))
    @Html.Raw(Item("dependency", "External dependencies", Url.Action("Catalogue", "ModernAdminServiceSchema", new { kind = "dependency" }) ?? "#"))
    @Html.Raw(Item("service-lines", "Service lines", Url.Action("ServiceLines", "ModernAdminServiceSchema") ?? "#"))
    @Html.Raw(Item("services", "Services", Url.Action("Services", "ModernAdminServiceSchema") ?? "#"))
    @Html.Raw(Item("user_group", "User groups", Url.Action("Catalogue", "ModernAdminServiceSchema", new { kind = "user_group" }) ?? "#"))
    @Html.Raw(Item("user_need", "User needs", Url.Action("Catalogue", "ModernAdminServiceSchema", new { kind = "user_need" }) ?? "#"))
    @Html.Raw(Item("journey", "Journeys", Url.Action("Catalogue", "ModernAdminServiceSchema", new { kind = "journey" }) ?? "#"))
    @Html.Raw(Item("feature", "Features", Url.Action("Catalogue", "ModernAdminServiceSchema", new { kind = "feature" }) ?? "#"))
  </ul>
</nav>
