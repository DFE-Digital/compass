@if (TempData["AdminError"] != null)
{
 <div class="govuk-error-summary" role="alert" style="margin-bottom:1.5rem;">
  <h2 class="govuk-error-summary__title">There is a problem</h2>
  <div class="govuk-error-summary__body"><p class="govuk-body">@TempData["AdminError"]</p></div>
 </div>
}
@if (TempData["AdminMessage"] != null)
{
 <div class="govuk-notification-banner govuk-notification-banner--success" role="region" style="margin-bottom:1.5rem;">
  <div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title">Success</h2></div>
  <div class="govuk-notification-banner__content"><p class="govuk-notification-banner__heading">@TempData["AdminMessage"]</p></div>
 </div>
}
