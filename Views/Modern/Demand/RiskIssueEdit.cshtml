@model Compass.Models.DemandPipeline.DemandPipelineRiskIssue
@using Compass.Models.Modern.Work
@using Compass.Models
@using Compass.ViewModels.Modern
@{
  var demandId = (Guid)ViewBag.DemandRequestId;
  var isIssue = string.Equals(Model.EntryType, "Issue", StringComparison.OrdinalIgnoreCase);
  var noun = isIssue ? "issue" : "risk";
  ViewData["Title"] = $"Edit {noun} — {ViewBag.DemandReference}";
  var backUrl = Url.Action("RequestDetail", "ModernDemand", new { id = demandId, tab = isIssue ? "issues" : "risks" }) ?? "#";
  var directorates = ViewBag.DirectorateOptions as List<RiskIssueNamedIntOption> ?? new List<RiskIssueNamedIntOption>();
}

@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Dashboard", "ModernDemand")">Demand</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Register", "ModernDemand")">Register</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@backUrl">@(ViewBag.DemandReference as string)</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">Edit @noun</li>
}

<div id="sc-demand-risk-form" class="dfe-c-mb-4">
  @{
    var editRiLede = await Html.PartialAsync("_GovukBodyParagraph", isIssue ? "Update the details of this issue." : "Update the details of this risk.");
  }
  @await Html.PartialAsync("_ModernPageHeader", new ModernPageHeaderViewModel {
    Caption = ViewBag.DemandReference as string,
    Title = $"Edit {noun}",
    Lede = editRiLede
  })

  <div class="dfe-c-form-layout">
    <div class="dfe-c-form-layout__main">
      <div class="dfe-c-card dfe-c-card--plain">
        <form method="post" action="@Url.Action("RequestEditRiskIssue", "ModernDemand", new { id = demandId, riskIssueId = Model.Id })" novalidate>
          @Html.AntiForgeryToken()
          <input type="hidden" name="entryType" value="@Model.EntryType" />

          @if (!ViewData.ModelState.IsValid)
          {
            <div class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert" data-module="govuk-error-summary">
              <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
              <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                  @foreach (var kv in ViewData.ModelState)
                  {
                    @if (kv.Value?.Errors?.Count > 0)
                    {
                      @foreach (var err in kv.Value.Errors)
                      {
                        <li>@err.ErrorMessage</li>
                      }
                    }
                  }
                </ul>
              </div>
            </div>
          }

          <div class="form-layout" style="margin-bottom:0">
            <fieldset class="govuk-fieldset">
              <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">@(isIssue ? "Issue" : "Risk") details</legend>

              <div class="govuk-form-group">
                <label class="govuk-label govuk-label--m" for="Title">Title <span style="color:#d4351c">*</span></label>
                <span class="govuk-hint">A short, clear description — e.g. &quot;@(isIssue ? "Data migration failed on staging" : "External vendor delivery delayed")&quot;</span>
                <input class="govuk-input govuk-!-width-full" id="Title" name="title" type="text" maxlength="500" autocomplete="off" required value="@Model.Title" />
              </div>

              <div class="govuk-form-group">
                <label class="govuk-label govuk-label--m" for="Description">Description <span style="color:#d4351c">*</span></label>
                <span class="govuk-hint">@(isIssue ? "What is it? Why has it arisen? What is the context?" : "What might happen? Why has it arisen? What is the context?")</span>
                <textarea class="govuk-textarea" id="Description" name="description" rows="4" required>@Model.Description</textarea>
              </div>

              <div class="govuk-form-group">
                <label class="govuk-label govuk-label--m" for="ImpactOnDelivery">Impact on delivery <span style="color:#d4351c">*</span></label>
                <span class="govuk-hint">@(isIssue ? "What effect does this have on timeline, scope, budget or quality?" : "What effect could this have on timeline, scope, budget or quality?")</span>
                <textarea class="govuk-textarea" id="ImpactOnDelivery" name="impactOnDelivery" rows="3" required>@Model.ImpactOnDelivery</textarea>
              </div>

              <div class="govuk-form-group">
                <label class="govuk-label govuk-label--m" for="Priority">Priority <span style="color:#d4351c">*</span></label>
                <select class="govuk-select govuk-!-width-full" id="Priority" name="priority" required>
                  <option value="">— Select —</option>
                  <option value="High" selected="@(string.Equals(Model.Priority, "High", StringComparison.OrdinalIgnoreCase))">High</option>
                  <option value="Medium" selected="@(string.Equals(Model.Priority, "Medium", StringComparison.OrdinalIgnoreCase))">Medium</option>
                  <option value="Low" selected="@(string.Equals(Model.Priority, "Low", StringComparison.OrdinalIgnoreCase))">Low</option>
                </select>
              </div>

              <div class="govuk-form-group">
                <label class="govuk-label govuk-label--m" for="Tier">Tier</label>
                <select class="govuk-select govuk-!-width-full" id="Tier" name="tier">
                  <option value="">— Select tier —</option>
                  <option value="Tier 1" selected="@(string.Equals(Model.Tier, "Tier 1", StringComparison.OrdinalIgnoreCase))">Tier 1</option>
                  <option value="Tier 2" selected="@(string.Equals(Model.Tier, "Tier 2", StringComparison.OrdinalIgnoreCase))">Tier 2</option>
                  <option value="Tier 3" selected="@(string.Equals(Model.Tier, "Tier 3", StringComparison.OrdinalIgnoreCase))">Tier 3</option>
                </select>
              </div>

              <div class="govuk-form-group">
                <label class="govuk-label govuk-label--m" for="DirectorateId">Directorate <span style="color:#d4351c">*</span></label>
                <span class="govuk-hint">DDT directorate for reporting.</span>
                <select class="govuk-select govuk-!-width-full" id="DirectorateId" name="directorateId" required>
                  <option value="">— Select directorate —</option>
                  @foreach (var d in directorates)
                  {
                    <option value="@d.Id" selected="@(Model.DirectorateId == d.Id)">@d.Name</option>
                  }
                </select>
              </div>

              <div class="govuk-form-group user-picker-wrapper user-picker-wrapper--full-width">
                @await Html.PartialAsync("_UserPicker", new UserPickerViewModel
                {
                  FieldName = "OwnerUserId",
                  Label = "Owner",
                  Hint = isIssue ? "Who is responsible for resolving this issue? Search by name or email." : "Who is responsible for managing this risk? Search by name or email.",
                  DefaultSummaryText = "No user selected.",
                  DefaultUserId = Model.OwnerUserId,
                  DefaultName = ViewBag.OwnerName as string,
                  DefaultEmail = ViewBag.OwnerEmail as string,
                  Placeholder = "",
                  UseGovUkStyling = true
                })
              </div>

              <div class="govuk-form-group">
                <label class="govuk-label govuk-label--m" for="TargetResolutionDate">@(isIssue ? "Target resolution date" : "Target review date")</label>
                <input class="govuk-input govuk-input--width-10" id="TargetResolutionDate" name="targetResolutionDate" type="date" value="@(Model.TargetResolutionDate?.ToString("yyyy-MM-dd"))" />
              </div>

              <div class="govuk-form-group">
                <label class="govuk-label govuk-label--m" for="MitigationOrAction">@(isIssue ? "Action plan" : "Mitigation plan") <span style="color:#d4351c">*</span></label>
                <span class="govuk-hint">@(isIssue ? "What is being done to resolve this issue?" : "What is being done to prevent this risk or reduce its impact?")</span>
                <textarea class="govuk-textarea" id="MitigationOrAction" name="mitigationOrAction" rows="3" required>@Model.MitigationOrAction</textarea>
              </div>
            </fieldset>
          </div>

          <div class="dfe-c-button-group">
            <button type="submit" class="govuk-button">Save changes</button>
            <a href="@backUrl" class="govuk-button govuk-button--secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>

    <div class="dfe-c-form-layout__aside">
      <div class="govuk-summary-card govuk-!-margin-bottom-4">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title">Risk vs issue</h2>
        </div>
        <div class="govuk-summary-card__content">
          <p class="govuk-body govuk-!-margin-bottom-0">@(isIssue ? "An issue is something that has happened or is happening now and needs resolution. A risk is a potential future problem you are monitoring." : "A risk is something that might happen — you monitor and mitigate before it occurs. An issue is something that has happened or is occurring now.")</p>
        </div>
      </div>
      <div class="govuk-summary-card govuk-!-margin-bottom-4">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title">Priority guidance</h2>
        </div>
        <div class="govuk-summary-card__content">
          <p class="govuk-body govuk-!-margin-bottom-0">@(isIssue ? "Use High when delivery, compliance or reputation is at immediate risk. Medium when milestones or quality are affected. Low when impact is limited and a plan is in place." : "Use High for risks that could affect statutory deadlines, funding or programme delivery. Medium for significant milestone or quality impact. Low for manageable risks with clear mitigations.")</p>
        </div>
      </div>
      <div class="govuk-summary-card">
        <div class="govuk-summary-card__title-wrapper">
          <h2 class="govuk-summary-card__title">@(isIssue ? "Action plan" : "Directorate")</h2>
        </div>
        <div class="govuk-summary-card__content">
          <p class="govuk-body govuk-!-margin-bottom-0">@(isIssue ? "Be specific about owners, dates and dependencies. This helps portfolio reviews and escalation." : "The directorate supports reporting and escalation. Pick the group that owns accountability for this risk.")</p>
        </div>
      </div>
    </div>
  </div>
</div>
