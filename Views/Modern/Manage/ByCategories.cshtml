@using Compass.Models.Modern.Work
@using Compass.ViewModels.Modern
@model FipsCategoryCutViewModel
@{
    ViewData["Title"] = $"By {Model.CutNoun}";
    var m = Model ?? new FipsCategoryCutViewModel();
    string Pct(decimal value) => value.ToString("0.#") + "%";
    string Badge(decimal percent) => WorkBadgeCss.ServiceRegisterCompletionBadgeClass(
        (int)Math.Round(percent, 0, MidpointRounding.AwayFromZero));
    string Page(string scope, string? value = null) =>
        Url.Action("ByCategories", "ModernManage", new { scope, cut = m.Cut, value }) ?? "#";
    var cutNouns = m.CutNoun + "s";
}

@section Breadcrumbs {
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "ModernDashboard")">Home</a></li>
  <li class="govuk-breadcrumbs__list-item"><a class="govuk-breadcrumbs__link" href="@Url.Action("FipsDashboard", "ModernManage")">Service register</a></li>
  <li class="govuk-breadcrumbs__list-item" aria-current="page">By @m.CutNoun</li>
}

@await Html.PartialAsync("~/Views/Modern/Shared/_ModernPageHeader.cshtml", new ModernPageHeaderViewModel {
  Caption = "Service register",
  Title = $"By {m.CutNoun}"
})

<p class="govuk-body">@m.ScopeLabel services, grouped by @m.CutNoun. Active and Enterprise match the Products catalogue. A service can sit in more than one @m.CutNoun, so the shares can add up to more than 100%. Data quality is how many of seven checks are recorded: service owner, information asset owner, a contact role, type, channel, user group, and phase.</p>

<nav class="dfe-f-sub-navigation govuk-!-margin-bottom-6" aria-label="Service population">
  <ul class="dfe-f-sub-navigation__list">
    <li class="dfe-f-sub-navigation__item@(m.Scope == "active" ? " dfe-f-sub-navigation__item--active" : "")">
      <a class="dfe-f-sub-navigation__link govuk-link govuk-link--no-visited-state" href="@Page("active")"@if (m.Scope == "active") { <text> aria-current="page"</text> }>Active</a>
    </li>
    <li class="dfe-f-sub-navigation__item@(m.Scope == "enterprise" ? " dfe-f-sub-navigation__item--active" : "")">
      <a class="dfe-f-sub-navigation__link govuk-link govuk-link--no-visited-state" href="@Page("enterprise")"@if (m.Scope == "enterprise") { <text> aria-current="page"</text> }>Enterprise</a>
    </li>
  </ul>
</nav>

<div class="dfe-f-card-grid govuk-!-margin-bottom-6" role="region" aria-label="@m.ScopeLabel services by @m.CutNoun">
  <div class="dfe-f-stat-card dfe-f-stat-card--tint-blue">
    <p class="govuk-body-s dfe-f-stat-card__label">@m.ScopeLabel services</p>
    <p class="dfe-f-stat-card__value dfe-f-u-tabular-numbers govuk-body-l">@m.ServiceCount</p>
    <p class="govuk-body-s govuk-!-margin-bottom-0">@m.ValueCount @(m.ValueCount == 1 ? m.CutNoun : cutNouns) in use</p>
  </div>
  <div class="dfe-f-stat-card dfe-f-stat-card--tint-orange">
    <p class="govuk-body-s dfe-f-stat-card__label">Not set</p>
    <p class="dfe-f-stat-card__value dfe-f-u-tabular-numbers govuk-body-l">@m.UnassignedCount</p>
    <p class="govuk-body-s govuk-!-margin-bottom-0">@Pct(m.ServiceCount == 0 ? 0 : Math.Round(m.UnassignedCount * 100m / m.ServiceCount, 1)) of this population</p>
  </div>
  <div class="dfe-f-stat-card dfe-f-stat-card--tint-teal">
    <p class="govuk-body-s dfe-f-stat-card__label">Data quality</p>
    <p class="dfe-f-stat-card__value dfe-f-u-tabular-numbers govuk-body-l">@Pct(m.DataQualityPercent)</p>
    <p class="govuk-body-s govuk-!-margin-bottom-0">@(string.IsNullOrWhiteSpace(m.WeakestField) ? "No services in this population" : $"Weakest check: {m.WeakestField.ToLowerInvariant()} at {Pct(m.WeakestFieldPercent)}")</p>
  </div>
</div>

<h2 class="govuk-heading-m">Data quality</h2>
<p class="govuk-body">Completion across all @m.ScopeLabel.ToLowerInvariant() services, before the @m.CutNoun cut.</p>
@await Html.PartialAsync("_CategoryFieldTable", m.Fields)

<h2 class="govuk-heading-m govuk-!-margin-top-8" id="category-cut">@m.CutLabel</h2>
<p class="govuk-body">Choose a @m.CutNoun to see its services and the data quality of that slice. Services with nothing recorded are listed as Not set.</p>

@if (m.Slices.Count == 0)
{
  <p class="govuk-body">No @m.ScopeLabel.ToLowerInvariant() services to cut.</p>
}
else
{
  <div class="dfe-f-table-wrapper">
    <table class="govuk-table govuk-table--small-text-until-tablet">
      <caption class="govuk-table__caption govuk-table__caption--m govuk-visually-hidden">@m.ScopeLabel services by @m.CutNoun</caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">@m.CutLabel</th>
          <th scope="col" class="govuk-table__header govuk-table__header--numeric">Services</th>
          <th scope="col" class="govuk-table__header govuk-table__header--numeric">Share</th>
          <th scope="col" class="govuk-table__header govuk-table__header--numeric">Data quality</th>
          <th scope="col" class="govuk-table__header govuk-table__header--numeric">Missing service owner</th>
          <th scope="col" class="govuk-table__header govuk-table__header--numeric">Missing information asset owner</th>
          <th scope="col" class="govuk-table__header govuk-table__header--numeric">Missing phase</th>
          <th scope="col" class="govuk-table__header">Largest gap</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        @foreach (var row in m.Slices)
        {
          var selected = m.Selected != null && m.Selected.ValueKey == row.ValueKey;
          <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">
              @if (selected)
              {
                <span>@row.Name</span>
              }
              else
              {
                <a class="govuk-link govuk-link--no-visited-state" href="@Page(m.Scope, row.ValueKey)#category-services">@row.Name</a>
              }
            </th>
            <td class="govuk-table__cell govuk-table__cell--numeric dfe-f-u-tabular-numbers">@row.ServiceCount</td>
            <td class="govuk-table__cell govuk-table__cell--numeric dfe-f-u-tabular-numbers">@Pct(row.SharePercent)</td>
            <td class="govuk-table__cell govuk-table__cell--numeric"><span class="@Badge(row.DataQualityPercent)">@Pct(row.DataQualityPercent)</span></td>
            <td class="govuk-table__cell govuk-table__cell--numeric dfe-f-u-tabular-numbers">@row.MissingServiceOwner</td>
            <td class="govuk-table__cell govuk-table__cell--numeric dfe-f-u-tabular-numbers">@row.MissingInformationAssetOwner</td>
            <td class="govuk-table__cell govuk-table__cell--numeric dfe-f-u-tabular-numbers">@row.MissingPhase</td>
            <td class="govuk-table__cell">@row.MainGap</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}

@if (m.Selected != null)
{
  <section class="govuk-!-margin-top-8" id="category-services" aria-labelledby="category-services-heading">
    <h2 id="category-services-heading" class="govuk-heading-m">@m.Selected.Name</h2>
    <p class="govuk-body">@m.Selected.ServiceCount @(m.Selected.ServiceCount == 1 ? "service" : "services")@(m.Selected.IsUnassigned ? $" with no {m.CutNoun} recorded" : $" in {m.Selected.Name}"). Data quality for the slice is @Pct(m.Selected.DataQualityPercent). The list is ordered with the least complete services first.</p>
    <p class="govuk-body"><a class="govuk-link govuk-link--no-visited-state" href="@Page(m.Scope)#category-cut">Show every @cutNouns</a></p>

    <h3 class="govuk-heading-s">Data quality of this cut</h3>
    @await Html.PartialAsync("_CategoryFieldTable", m.SelectedFields)

    <h3 class="govuk-heading-s govuk-!-margin-top-6">Services</h3>
    @if (m.Services.Count == 0)
    {
      <p class="govuk-body">No services in this cut.</p>
    }
    else
    {
      <div class="dfe-f-table-wrapper">
        <table class="govuk-table govuk-table--small-text-until-tablet">
          <caption class="govuk-table__caption govuk-table__caption--m govuk-visually-hidden">Services in @m.Selected.Name</caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Service</th>
              <th scope="col" class="govuk-table__header">Phase</th>
              <th scope="col" class="govuk-table__header govuk-table__header--numeric">Data quality</th>
              <th scope="col" class="govuk-table__header">Missing</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            @foreach (var service in m.Services)
            {
              <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">
                  <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("FipsProduct", "ModernManage", new { id = service.ProductId })">@service.Title</a>
                  @if (service.UniqueId != 0)
                  {
                    <span class="govuk-body-s govuk-!-margin-left-1">#@service.UniqueId</span>
                  }
                </th>
                <td class="govuk-table__cell">@service.Phase</td>
                <td class="govuk-table__cell govuk-table__cell--numeric"><span class="@Badge(service.CompletionPercent)">@service.CompletionPercent%</span></td>
                <td class="govuk-table__cell">@(string.IsNullOrWhiteSpace(service.MissingFields) ? "None" : service.MissingFields)</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </section>
}
