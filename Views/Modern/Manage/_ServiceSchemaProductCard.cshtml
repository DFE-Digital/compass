@model Compass.ViewModels.Modern.ServiceSchemaProductCard
@using Compass.Models.Modern.Work
<div class="govuk-grid-column-one-half">
  <div class="govuk-summary-card govuk-!-margin-bottom-4">
    <div class="govuk-summary-card__title-wrapper">
      <h3 class="govuk-summary-card__title">
        <a class="govuk-link govuk-link--no-visited-state" href="@Url.Action("FipsProduct", "ModernManage", new { id = Model.Id, tab = "additional" })">@Model.Title</a>
      </h3>
    </div>
    <div class="govuk-summary-card__content">
      <p class="govuk-body govuk-!-margin-bottom-2">@Model.BusinessAreas</p>
      <p class="govuk-body govuk-!-margin-bottom-1">
        <span class="@WorkBadgeCss.ServiceRegisterCompletionBadgeClass(Model.SchemaPercent)">@Model.SchemaPercent% schema</span>
        <span class="govuk-body-s">@Model.SectionsAddressed of @Model.SectionCount sections</span>
      </p>
      <p class="govuk-body govuk-!-margin-bottom-0">
        <span class="@WorkBadgeCss.ServiceRegisterCompletionBadgeClass(Model.DqPercent)">@Model.DqPercent% DQ</span>
      </p>
    </div>
  </div>
</div>
