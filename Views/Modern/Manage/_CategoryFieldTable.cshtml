@using Compass.Models.Modern.Work
@model IReadOnlyList<Compass.ViewModels.Modern.FipsCategoryFieldRow>
@{
    var rows = Model ?? Array.Empty<Compass.ViewModels.Modern.FipsCategoryFieldRow>();
    string Badge(decimal percent) => WorkBadgeCss.ServiceRegisterCompletionBadgeClass(
        (int)Math.Round(percent, 0, MidpointRounding.AwayFromZero));
}
@if (rows.Count == 0)
{
  <p class="govuk-body">No services in this cut.</p>
}
else
{
  <div class="dfe-f-table-wrapper">
    <table class="govuk-table govuk-table--small-text-until-tablet">
      <caption class="govuk-table__caption govuk-table__caption--m govuk-visually-hidden">Data quality checks</caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">Check</th>
          <th scope="col" class="govuk-table__header govuk-table__header--numeric">Recorded</th>
          <th scope="col" class="govuk-table__header govuk-table__header--numeric">Missing</th>
          <th scope="col" class="govuk-table__header govuk-table__header--numeric">Completion</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        @foreach (var row in rows)
        {
          <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">@row.Field <span class="govuk-body-s govuk-hint">@row.Hint</span></th>
            <td class="govuk-table__cell govuk-table__cell--numeric dfe-f-u-tabular-numbers">@row.Complete</td>
            <td class="govuk-table__cell govuk-table__cell--numeric dfe-f-u-tabular-numbers">@row.Missing</td>
            <td class="govuk-table__cell govuk-table__cell--numeric"><span class="@Badge(row.CompletionPercent)">@row.CompletionPercent.ToString("0.#")%</span></td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}
