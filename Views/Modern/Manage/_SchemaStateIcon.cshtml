@model Compass.ViewModels.Modern.ServiceSchemaTopicNav
<svg class="ss-state is-@Model.State" viewBox="0 0 20 20" role="img" aria-label="@Model.StateLabel" focusable="false">
  <title>@Model.StateLabel</title>
  @if (Model.State == "recorded")
  {
    <circle cx="10" cy="10" r="8.25" fill="currentColor" />
    <path fill="#fff" d="M8.4 13.35 5.7 10.65l1.05-1.05 1.65 1.65 4.05-4.05 1.05 1.05-5.1 5.1z" />
  }
  else if (Model.State == "partial")
  {
    <circle cx="10" cy="10" r="8.25" fill="currentColor" />
  }
  else
  {
    <circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.75" />
  }
</svg>
