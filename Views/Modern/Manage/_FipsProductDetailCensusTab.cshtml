@model FipsProductDetailViewModel
@using Compass.Models.ServiceDataModels
@using Compass.Services.ServiceDataModels
@{
  var panel = Model.CensusPanel;
}

<div id="d-fips-census" class="tab-pane @(Model.ActiveDetailTab == "census" ? "on" : "")" role="tabpanel">
  <h2 class="govuk-heading-m govuk-!-margin-top-0">Census</h2>
  <p class="govuk-body">Standing service data for this product, including Service Census. Open it any time to complete answers or keep them current.</p>

  @if (panel == null)
  {
    <p class="govuk-body govuk-!-margin-bottom-0">You do not have access to census for this product, or none could be loaded.</p>
  }
  else if (panel.Assignments.Count == 0)
  {
    <p class="govuk-body govuk-!-margin-bottom-0">An administrator has not published a Service Census yet, or none applies to this service.</p>
  }
  else
  {
    <div class="dfe-f-table-wrapper" data-module="dfe-f-table">
      <div class="govuk-visually-hidden" aria-live="polite" data-dfe-table-sort-live></div>
      <table class="govuk-table govuk-table--small-text-until-tablet dfe-f-table--condensed">
        <caption class="govuk-table__caption govuk-table__caption--m govuk-visually-hidden">Census for this service</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Model</button></th>
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Status</button></th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Completion</button></th>
            <th scope="col" class="govuk-table__header" aria-sort="none"><button type="button" class="dfe-f-table-sort-button">Updated</button></th>
            <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Action</span></th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          @foreach (var item in panel.Assignments)
          {
            var openHref = string.Equals(item.ModelStableKey, "service-census", StringComparison.OrdinalIgnoreCase)
              ? Url.Action("OpenForProduct", "ModernCensus", new { productId = Model.Product.Id })
              : Url.Action("Assignment", "ModernCensus", new { assignmentId = item.AssignmentId });
            <tr class="govuk-table__row">
              <td class="govuk-table__cell"><strong>@item.ModelName</strong></td>
              <td class="govuk-table__cell">
                <span class="dfe-f-badge dfe-f-badge--small">@CensusWorkListBuilder.FormatStatusLabel(item.Status)</span>
                @if (item.IsOverdue)
                {
                  <span class="dfe-f-badge dfe-f-badge--small dfe-f-badge--red">Overdue</span>
                }
              </td>
              <td class="govuk-table__cell govuk-table__cell--numeric">@(item.FieldCompletionPercent.HasValue ? $"{item.FieldCompletionPercent:0}%" : "—")</td>
              <td class="govuk-table__cell">@(item.LastAnsweredUtc?.ToString("d MMM yyyy") ?? item.UpdatedUtc.ToString("d MMM yyyy"))</td>
              <td class="govuk-table__cell">
                <a class="govuk-link govuk-link--no-visited-state" href="@openHref">
                  @(item.Status == ServiceDataModelAssignmentStatus.NotStarted ? "Start" : "Open")
                </a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
